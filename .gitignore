# Supplier catalogue source files (TASK-360). Real business data belongs to the
# client, changes daily, and has nothing to do with a code revision — it is
# uploaded through the admin import page, never committed.
*.xlsx
*.xls

# Seed image bundle for the demo stand (docs/deploy/03b step 7). A tar of
# apps/store-api/uploads/products, made only to scp the generated catalogue
# pictures to the server so it does not have to regenerate them. Rebuildable in
# one command, ~1 MB of binaries, and tied to one deploy — never a code revision.
seed-images.tgz
