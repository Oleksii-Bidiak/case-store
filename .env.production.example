# ============================================================================
# .env.production.example — consolidated production config for the whole stack
# (TASK-270). Copy to `.env.production` and fill in REAL secrets, then either:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
# or copy it to `.env` (compose auto-loads `.env`). NEVER commit a real one.
#
# Generate strong secrets with:
#   openssl rand -hex 32     <- on the SERVER (a deploy box has Docker but no Node)
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"   <- on your laptop
# Prefer hex: it has no characters that would need URL-encoding inside DATABASE_URL.
#
# ⚠ BUILD-TIME vs RUNTIME: every NEXT_PUBLIC_* var below is baked into the
#   storefront/admin JS bundle at `docker build` time (passed as build-args), NOT
#   read when the container starts. Changing any of them — especially
#   NEXT_PUBLIC_API_URL, which also fixes next/image's allowed remote origin —
#   requires REBUILDING the image (`docker compose ... up -d --build`), not just
#   restarting the container. A built image is tied to one environment's domains.
#
# Every variable below — plus the tuning knobs that are deliberately NOT here —
# is listed with its consequence in docs/deploy/04a-env-matrix.md. That table is
# machine-checked against this file, the compose files and the code by
# `node scripts/env-check.js --audit`, so it cannot quietly fall behind.
# ============================================================================

# ─── Reverse proxy / domains (Caddy) ────────────────────────────────────────
# Root storefront domain. Caddy also serves admin.<DOMAIN> and api.<DOMAIN> and
# provisions Let's Encrypt certs automatically (DNS must point here, ports 80/443
# reachable). For a LOCAL smoke test use `localhost` (Caddy uses its internal CA).
# The domain may itself be a subdomain (e.g. shop.client.com) — it is just a
# string; admin./api. are prefixed onto it. See docs/deploy/02-domain-dns.md.
DOMAIN=example.com

# STAGING ONLY — required by docker-compose.staging.yml, which wraps all three
# sites in basic auth (`/health` stays open for the smoke check and uptime
# monitor). Leave empty on production: the prod Caddyfile has no basic_auth block
# and never reads this. Generate the hash with:
#   docker run --rm caddy caddy hash-password --plaintext '<password>'
# Paste the $2a$... hash VERBATIM — do not double the `$` (that is only needed for
# a hash written inline in a compose file; compose reads this one from the env
# file and passes it through untouched). Username is `staging`.
STAGING_BASIC_AUTH=

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
# The app's DATABASE_URL is DERIVED from these three by docker-compose.prod.yml
# (postgresql://USER:PASSWORD@postgres:5432/DB) — do not set DATABASE_URL here.
# URL-encode any special characters you put in POSTGRES_PASSWORD.
POSTGRES_USER=store
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=store

# ─── Redis (cache + rate-limit store) ───────────────────────────────────────
# REQUIRED in production (unlike dev). env.validation reads HOST/PORT/PASSWORD —
# there is intentionally NO REDIS_URL var. REDIS_HOST is the compose service name.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-strong-redis-password
# Cache TTL for cached reads, in seconds (optional; default 60).
REDIS_CACHE_TTL_SECONDS=60

# ─── Meilisearch (full-text search) ─────────────────────────────────────────
# Master key MUST be >= 16 chars (Meili's own requirement in production mode).
# The app reads MEILI_HOST + MEILI_MASTER_KEY; both the meilisearch service and
# store-api share the same MEILI_MASTER_KEY. Leave MEILI_* and the app still
# boots — search transparently falls back to a Postgres scan.
MEILI_MASTER_KEY=change-me-to-a-master-key-min-16-chars
MEILI_ENV=production
# Internal engine URL on the compose network (override only if external).
MEILI_HOST=http://meilisearch:7700

# ─── Umami analytics ────────────────────────────────────────────────────────
# App secret for Umami's own auth/session signing (>=32 chars recommended).
# Umami stores data in its own `umami` DB inside the shared Postgres.
UMAMI_APP_SECRET=change-me-to-a-32-plus-character-umami-secret

# ─── store-api — runtime port ───────────────────────────────────────────────
# The API listens on this port; Caddy proxies api.<DOMAIN> to it. NODE_ENV is
# fixed to `production` by the compose file, so it is not set here.
PORT=3001

# ─── store-api — Auth (JWT) ─────────────────────────────────────────────────
# Both secrets MUST be at least 32 characters and MUST differ from each other.
JWT_SECRET=change-me-to-a-32-plus-character-random-secret
JWT_REFRESH_SECRET=change-me-to-a-different-32-plus-char-secret
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ─── store-api — CORS ───────────────────────────────────────────────────────
# Comma-separated allowed origins — the real storefront + admin origins (https).
CORS_ORIGINS=https://example.com,https://admin.example.com

# ─── store-api — CSRF (prod-only requirement) ───────────────────────────────
# REQUIRED in production (optional in the dev-facing apps/store-api/.env.example):
# CsrfService warns and falls back to a weak default at boot if this is unset.
# Must be at least 32 characters — it is the HMAC key signing the CSRF token.
CSRF_SECRET=change-me-to-a-32-plus-character-csrf-secret

# ─── store-api — public origin for served images (prod-only requirement) ────
# Absolute public origin of the API, used to build uploaded-image URLs
# (<PUBLIC_BASE_URL>/uploads/products/<file>). MUST be the real api.<DOMAIN>
# origin in production, or served product images link back to localhost.
PUBLIC_BASE_URL=https://api.example.com
# ─── store-api — file storage ───────────────────────────────────────────────
# Upload root (relative to the API's working dir). The compose file mounts a
# named volume at apps/store-api/uploads so images survive redeploys — keep the
# default unless you also move the volume mount.
UPLOAD_DEST=./uploads

# ─── store-api — transactional email (SMTP) ─────────────────────────────────
# All optional. When MAIL_ENABLED != "true", no email is sent and SMTP_* are
# ignored. Set MAIL_ENABLED=true + real SMTP creds to send order/registration mail.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
# "true" for implicit TLS (port 465); otherwise STARTTLS (port 587).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MobileStore <no-reply@example.com>"

# ─── store-api — Nova Poshta delivery ───────────────────────────────────────
# Optional. Without NP_API_KEY the delivery endpoints return 503 and checkout
# falls back to free-text address entry. NP_SENDER_CITY_REF: dispatch-origin city
# UUID fallback (defaults to Kyiv when empty).
NP_API_KEY=
NP_SENDER_CITY_REF=
# NEVER "true" in production. Verified 2026-07-28: every NP method this project
# calls (city search, warehouses, price, ETA) answers with an EMPTY apiKey, so a
# staging box can exercise the real API before the client issues a key. That
# behaviour is undocumented and Nova Poshta may withdraw it at any time, and
# anonymous calls are certainly rate-limited — so production must fail loudly on a
# missing key instead (TASK-337) rather than quietly charging 0.00 for shipping.
NP_ALLOW_KEYLESS=false

# ─── store-api — online payments, LiqPay (TASK-330) ─────────────────────────
# Both keys come from the LiqPay merchant cabinet, which the SHOP OWNER registers
# on their own ФОП — see docs/deploy/01-accounts-access.md. Two pairs exist: the
# live one, and a test pair whose values start with "sandbox_".
# Empty keys = online payment is simply unavailable; the storefront falls back to
# cash on delivery. The private key is server-side only and must never reach a
# frontend build arg.
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
# "true" ONLY on staging. In production this must stay false: sandbox mode makes
# LiqPay report status "sandbox", which the adapter treats as a successful
# payment — leave it on in production and anyone who learns the public key can
# mark orders paid.
LIQPAY_SANDBOX=false
# Payment methods LiqPay offers on its page. `payparts` / `moment_part`
# (ПриватБанк instalments) need a SEPARATE agreement with the bank on top of
# ordinary acquiring — list them only once that is signed, otherwise the button
# appears and fails. See docs/payments-liqpay.md §11.
LIQPAY_PAYTYPES=card,apay,gpay,privat24
# Safety net for callbacks that never arrive: LiqPay does not document its retry
# behaviour, so without this a customer can pay while the order stays unpaid
# forever. Cron expression; every minute by default.
PAYMENT_RECONCILE_CRON=* * * * *

# ─── store-api — unpaid online orders (owner decision 2026-07-28) ───────────
# Stock is reserved when the order is created, before any payment — otherwise two
# shoppers could both pay for the last unit. For CARD orders that reservation gets
# a deadline; cash-on-delivery orders keep theirs indefinitely.
# Open question with the client (TASK-352): whether 30 minutes is right, whether
# to send a reminder first. Both are settings on purpose, so the answer is an env
# change rather than a code change.
ORDER_RESERVATION_TTL_MINUTES=30
# "false" disables auto-cancellation entirely: unpaid orders then hold their stock
# until an operator intervenes.
ORDER_AUTOCANCEL_UNPAID=true
# How long a guest's order-status link stays valid (TASK-338). It is the only way
# a guest can see their own order once the cart cookie is gone.
GUEST_ORDER_TOKEN_TTL_DAYS=60

# ─── store-api — admin 2FA (TASK-344) ───────────────────────────────────────
# Encrypts TOTP secrets at rest (AES-256-GCM). Required only once 2FA is enabled;
# LOSING IT LOCKS EVERY ENROLLED ADMIN OUT — no re-derivation is possible, only
# backup codes. Store it in the password manager alongside the age backup key.
# Generate: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=
# How long the "confirm your address" link from the email stays usable (TASK-342).
EMAIL_VERIFICATION_TOKEN_EXPIRATION=24h
# How long the RBAC guard caches a role's permissions — i.e. the LONGEST a
# permission you just revoked can still be honoured (TASK-334). 0 disables the
# cache and queries the database on every admin request. Raise this only
# deliberately: it is the window in which a dismissed employee still has access.
RBAC_PERMISSION_CACHE_TTL_SECONDS=60

# ─── store-client — payment methods shown at checkout (build-time) ──────────
# Comma-separated, in OUR vocabulary, not the provider's `paytypes`:
#   ON_DELIVERY,ONLINE,INSTALLMENTS
# Empty (the default) means the checkout offers cash on delivery only — which is
# the correct state until the LiqPay keys above are real. Baked into the bundle
# at build time, so changing it requires a rebuild of store-client.
NEXT_PUBLIC_PAYMENT_METHODS=

# ─── store-api — Sentry error tracking ──────────────────────────────────────
# Optional. Leave SENTRY_DSN empty to disable Sentry entirely (no-op).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Performance-trace sample rate 0..1 (default 0 = off).
SENTRY_TRACES_SAMPLE_RATE=0

# ─── ISR revalidation — store-api ↔ store-client (TASK-187) ─────────────────
# REQUIRED. One shared secret, the SAME value in both containers (compose passes
# it to each). After an admin publishes or edits content, the API calls the
# storefront and the changed pages are dropped from the ISR cache.
#
# Leave it empty and the stack refuses to start — deliberately. Until TASK-324
# this variable was in neither compose file, so on a running production site the
# storefront answered 503 to every revalidation and NOTHING an operator changed
# in the admin panel appeared on the shop until the cache expired by itself. That
# looks like "the admin panel does not work", nobody reports it as an outage, and
# no health check sees it.
#
#   openssl rand -hex 32     <- on the SERVER
REVALIDATE_SECRET=change-me-to-a-32-plus-character-revalidate-secret

# Optional. Where the API sends those purge requests. The default is the internal
# compose-network address of the storefront — no reason to go out through Caddy
# and back. Change ONLY if the storefront runs outside this stack.
STOREFRONT_REVALIDATE_URL=http://store-client:3000/api/revalidate

# ─── store-client — IndexNow (optional) ─────────────────────────────────────
# Empty = IndexNow pings are skipped: Bing and Seznam then discover new products
# on their own crawl schedule instead of within minutes. Google does not use the
# protocol at all. Nothing breaks either way.
# The same value must be served at https://<DOMAIN>/indexnow.txt — that file is
# how the search engine verifies you own the domain.
#   openssl rand -hex 16
INDEXNOW_KEY=

# ─── store-client — server-side fetch timeout (optional, TASK-327) ──────────
# How long a server-rendered page waits for the API before giving up and showing
# its degraded state instead of hanging. Unset, the code default (5000 ms) applies.
# Raise it only if the API is reliably slower than this. Note: this covers
# request-time fetches; build-time fetches are not affected by it.
SERVER_FETCH_TIMEOUT_MS=5000

# ─── store-api — Google sign-in (optional, TASK-168) ────────────────────────
# Leave ALL THREE empty and everything still works — the "Sign in with Google"
# button simply answers 503 and customers use email + password. This is designed
# degradation, not a fault. Fill them in only after creating an OAuth client in
# Google Cloud Console → APIs & Services → Credentials.
#
# GOOGLE_CALLBACK_URL must be EXACTLY the "Authorized redirect URI" registered
# there — one differing character and Google refuses with redirect_uri_mismatch:
#   https://api.<DOMAIN>/api/auth/google/callback
#
# ⚠ Google sign-in is for CUSTOMERS ONLY. Since TASK-314 the storefront's Google
#   flow never issues a token for any role other than CUSTOMER, so an
#   administrator cannot log into the admin panel this way — by design, not a
#   fault. Admins sign in with email + password at admin.<DOMAIN>.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# ─── store-api — Umami CSP origin (see TASK-261) ────────────────────────────
# Optional. When set, the API's Helmet CSP allows the Umami script/connect
# origin. Set it to the same public origin that serves the storefront's
# NEXT_PUBLIC_UMAMI_SRC (leave empty until Umami is exposed on a public domain).
#
# NOTE: this affects the API's OWN responses only. The storefront ships without
# a CSP by design (see apps/store-client/next.config.ts), so leaving this empty
# does NOT stop the tracking script from loading.
UMAMI_ORIGIN=

# ─── store-api — Umami read API for the admin traffic card (TASK-380) ───────
# All four or none. Set them and the dashboard's "Відвідуваність" card shows
# real numbers; leave them empty and it stays the plain link it has always been.
# These credentials never reach the browser — the admin panel asks OUR API and
# our API asks Umami, which is the whole reason this proxy exists.
#
# Create a SEPARATE Umami user for this (Settings → Users) and give it read
# access to the website. Do not reuse the owner's login.
# Step-by-step: docs/deploy/05a-analytics.md
UMAMI_API_URL=http://umami:3000
UMAMI_API_USERNAME=
UMAMI_API_PASSWORD=
# The website UUID from Umami — the same value as NEXT_PUBLIC_UMAMI_WEBSITE_ID.
UMAMI_WEBSITE_ID=

# ─── store-api — logging ────────────────────────────────────────────────────
# Optional Pino level override (trace|debug|info|warn|error|fatal|silent).
# Defaults to info in production.
LOG_LEVEL=info

# ─── Backups (scripts/backup.sh) ────────────────────────────────────────────
# `backup.sh` sources THIS file, so these belong here. The production deploy
# takes a backup BEFORE migrating and aborts if it fails — so a missing
# AGE_PUBLIC_KEY does not just skip backups, it blocks the deploy.
# Full runbook: docs/deploy/08-backup-restore.md
#
# REQUIRED. The PUBLIC half of an `age` keypair (`age-keygen -o backup-key.txt`,
# run on your laptop — never on the server). backup.sh refuses to start without
# it, and rejects anything that is not an age1... public key.
#
# ⚠ The PRIVATE half must NEVER be on the server: whoever gets root would
#   otherwise get every historical backup, customer data included. The server is
#   meant to create backups it cannot itself read. Keep the private key in a
#   password manager — held by BOTH you and the client, plus a printed copy.
#   Lose it and every encrypted archive is permanently unreadable random bytes.
AGE_PUBLIC_KEY=

# Optional but strongly recommended: off-site copy target. Without it backups
# stay on the same server they protect — which is no protection against losing
# that server. Set the long retention as a LIFECYCLE RULE on the bucket, not
# here: a compromised server must not be able to erase your backup history.
RCLONE_REMOTE=

# Optional. Defaults: BACKUP_DIR=<repo>/backups, BACKUP_KEEP_DAYS=7 (local only).
BACKUP_DIR=
BACKUP_KEEP_DAYS=

# ============================================================================
# BUILD-TIME public config (baked into the storefront/admin bundles).
# See the ⚠ note at the top: changing any of these needs an image REBUILD.
# ============================================================================

# ─── store-client + store-admin — public API/app origins ────────────────────
# NEXT_PUBLIC_API_URL also drives next/image's whitelisted remote origin for the
# storefront — a built image is tied to this exact API domain.
#
# NEXT_PUBLIC_APP_URL has a SECOND job that is easy to miss: compose also hands
# it to store-api as STORE_CLIENT_URL, which is where the API sends people back
# to — the Google-OAuth callback and the "reset your password" link in the email.
# Get it wrong and those two journeys break while the shop itself looks fine.
# No trailing slash (the API refuses to start with one).
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_APP_URL=https://example.com
NEXT_PUBLIC_ADMIN_URL=https://admin.example.com

# ─── store-client — SEO + currency ──────────────────────────────────────────
# Canonical origin + currency for SEO (sitemap, robots, JSON-LD, canonical).
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_CURRENCY=UAH

# ─── store-client — extra allowed image hosts (optional, TASK-348) ──────────
# Comma-separated BARE HOSTNAMES (no scheme, no path), e.g.
# `cdn.mystore.ua,images.brand.com`. Only needed if a category tile's image is
# hosted somewhere other than this store's own API.
#
# Leave empty and nothing breaks: the only optimizable remote origin is
# NEXT_PUBLIC_API_URL, and a tile pointing anywhere else quietly falls back to
# its placeholder instead of rendering. That silent fallback is the whole cost —
# there is no error, no log line, just a category with no picture. Add a host
# here the moment you paste an external image URL into a category in the admin.
NEXT_PUBLIC_IMAGE_HOSTS=

# ─── store-client + store-admin — Sentry (browser) ──────────────────────────
# Optional; leave the DSN empty to disable the browser SDK.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# ─── store-client — Umami tracking (script baked at build time, see TASK-261) ─
# Public URL of the Umami tracking script and the website id. Leave empty to
# ship the storefront without analytics. To serve these publicly, expose the
# umami service behind a domain (e.g. analytics.<DOMAIN>) and set NEXT_PUBLIC_
# UMAMI_SRC to that script URL.
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# ─── store-admin — link out to the Umami dashboard (optional, TASK-348) ─────
# Full URL of THIS store's website view inside Umami's own UI, e.g.
# https://analytics.example.com/websites/<website-id>. Different thing from the
# two vars above: those load Umami's tracking *script* into the storefront, this
# one is only a link the admin panel shows the owner. store-admin never loads
# the tracker.
#
# Leave empty and nothing breaks: the dashboard's "Відвідуваність" card renders
# muted and linkless rather than dead-linking. The cost of leaving it empty is
# that the owner has to find Umami by bookmark instead of from the admin panel.
# Only fill it in once Umami is actually reachable on a public domain.
NEXT_PUBLIC_UMAMI_DASHBOARD_URL=

# ─── Sentry source-map upload (build time only — optional) ──────────────────
# Set all three in your build/CI environment to upload readable stack traces.
# Unset, the build still succeeds and upload is skipped with a warning.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
