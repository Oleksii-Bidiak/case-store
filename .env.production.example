# ============================================================================
# .env.production.example — consolidated production config for the whole stack
# (TASK-270). Copy to `.env.production` and fill in REAL secrets, then either:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
# or copy it to `.env` (compose auto-loads `.env`). NEVER commit a real one.
#
# Generate strong secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# ⚠ BUILD-TIME vs RUNTIME: every NEXT_PUBLIC_* var below is baked into the
#   storefront/admin JS bundle at `docker build` time (passed as build-args), NOT
#   read when the container starts. Changing any of them — especially
#   NEXT_PUBLIC_API_URL, which also fixes next/image's allowed remote origin —
#   requires REBUILDING the image (`docker compose ... up -d --build`), not just
#   restarting the container. A built image is tied to one environment's domains.
# ============================================================================

# ─── Reverse proxy / domains (Caddy) ────────────────────────────────────────
# Root storefront domain. Caddy also serves admin.<DOMAIN> and api.<DOMAIN> and
# provisions Let's Encrypt certs automatically (DNS must point here, ports 80/443
# reachable). For a LOCAL smoke test use `localhost` (Caddy uses its internal CA).
DOMAIN=example.com

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
# The app's DATABASE_URL is DERIVED from these three by docker-compose.prod.yml
# (postgresql://USER:PASSWORD@postgres:5432/DB) — do not set DATABASE_URL here.
# URL-encode any special characters you put in POSTGRES_PASSWORD.
POSTGRES_USER=store
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=store

# ─── Redis (cache + rate-limit store) ───────────────────────────────────────
# REQUIRED in production (unlike dev). env.validation reads HOST/PORT/PASSWORD —
# there is intentionally NO REDIS_URL var. REDIS_HOST is the compose service name.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-strong-redis-password
# Cache TTL for cached reads, in seconds (optional; default 60).
REDIS_CACHE_TTL_SECONDS=60

# ─── Meilisearch (full-text search) ─────────────────────────────────────────
# Master key MUST be >= 16 chars (Meili's own requirement in production mode).
# The app reads MEILI_HOST + MEILI_MASTER_KEY; both the meilisearch service and
# store-api share the same MEILI_MASTER_KEY. Leave MEILI_* and the app still
# boots — search transparently falls back to a Postgres scan.
MEILI_MASTER_KEY=change-me-to-a-master-key-min-16-chars
MEILI_ENV=production
# Internal engine URL on the compose network (override only if external).
MEILI_HOST=http://meilisearch:7700

# ─── Umami analytics ────────────────────────────────────────────────────────
# App secret for Umami's own auth/session signing (>=32 chars recommended).
# Umami stores data in its own `umami` DB inside the shared Postgres.
UMAMI_APP_SECRET=change-me-to-a-32-plus-character-umami-secret

# ─── store-api — runtime port ───────────────────────────────────────────────
# The API listens on this port; Caddy proxies api.<DOMAIN> to it. NODE_ENV is
# fixed to `production` by the compose file, so it is not set here.
PORT=3001

# ─── store-api — Auth (JWT) ─────────────────────────────────────────────────
# Both secrets MUST be at least 32 characters and MUST differ from each other.
JWT_SECRET=change-me-to-a-32-plus-character-random-secret
JWT_REFRESH_SECRET=change-me-to-a-different-32-plus-char-secret
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ─── store-api — CORS ───────────────────────────────────────────────────────
# Comma-separated allowed origins — the real storefront + admin origins (https).
CORS_ORIGINS=https://example.com,https://admin.example.com

# ─── store-api — CSRF (prod-only requirement) ───────────────────────────────
# REQUIRED in production (optional in the dev-facing apps/store-api/.env.example):
# CsrfService warns and falls back to a weak default at boot if this is unset.
# Must be at least 32 characters — it is the HMAC key signing the CSRF token.
CSRF_SECRET=change-me-to-a-32-plus-character-csrf-secret

# ─── store-api — public origin for served images (prod-only requirement) ────
# Absolute public origin of the API, used to build uploaded-image URLs
# (<PUBLIC_BASE_URL>/uploads/products/<file>). MUST be the real api.<DOMAIN>
# origin in production, or served product images link back to localhost.
PUBLIC_BASE_URL=https://api.example.com

# ─── store-api — file storage ───────────────────────────────────────────────
# Upload root (relative to the API's working dir). The compose file mounts a
# named volume at apps/store-api/uploads so images survive redeploys — keep the
# default unless you also move the volume mount.
UPLOAD_DEST=./uploads

# ─── store-api — transactional email (SMTP) ─────────────────────────────────
# All optional. When MAIL_ENABLED != "true", no email is sent and SMTP_* are
# ignored. Set MAIL_ENABLED=true + real SMTP creds to send order/registration mail.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
# "true" for implicit TLS (port 465); otherwise STARTTLS (port 587).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MobileStore <no-reply@example.com>"

# ─── store-api — Nova Poshta delivery ───────────────────────────────────────
# Optional. Without NP_API_KEY the delivery endpoints return 503 and checkout
# falls back to free-text address entry. NP_SENDER_CITY_REF: dispatch-origin city
# UUID fallback (defaults to Kyiv when empty).
NP_API_KEY=
NP_SENDER_CITY_REF=

# ─── store-api — Sentry error tracking ──────────────────────────────────────
# Optional. Leave SENTRY_DSN empty to disable Sentry entirely (no-op).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Performance-trace sample rate 0..1 (default 0 = off).
SENTRY_TRACES_SAMPLE_RATE=0

# ─── store-api — Umami CSP origin (see TASK-261) ────────────────────────────
# Optional. When set, the API's Helmet CSP allows the Umami script/connect
# origin. Set it to the same public origin that serves the storefront's
# NEXT_PUBLIC_UMAMI_SRC (leave empty until Umami is exposed on a public domain).
UMAMI_ORIGIN=

# ─── store-api — logging ────────────────────────────────────────────────────
# Optional Pino level override (trace|debug|info|warn|error|fatal|silent).
# Defaults to info in production.
LOG_LEVEL=info

# ============================================================================
# BUILD-TIME public config (baked into the storefront/admin bundles).
# See the ⚠ note at the top: changing any of these needs an image REBUILD.
# ============================================================================

# ─── store-client + store-admin — public API/app origins ────────────────────
# NEXT_PUBLIC_API_URL also drives next/image's whitelisted remote origin for the
# storefront — a built image is tied to this exact API domain.
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_APP_URL=https://example.com
NEXT_PUBLIC_ADMIN_URL=https://admin.example.com

# ─── store-client — SEO + currency ──────────────────────────────────────────
# Canonical origin + currency for SEO (sitemap, robots, JSON-LD, canonical).
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_CURRENCY=UAH

# ─── store-client + store-admin — Sentry (browser) ──────────────────────────
# Optional; leave the DSN empty to disable the browser SDK.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# ─── store-client — Umami tracking (script baked at build time, see TASK-261) ─
# Public URL of the Umami tracking script and the website id. Leave empty to
# ship the storefront without analytics. To serve these publicly, expose the
# umami service behind a domain (e.g. analytics.<DOMAIN>) and set NEXT_PUBLIC_
# UMAMI_SRC to that script URL.
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# ─── Sentry source-map upload (build time only — optional) ──────────────────
# Set all three in your build/CI environment to upload readable stack traces.
# Unset, the build still succeeds and upload is skipped with a warning.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
