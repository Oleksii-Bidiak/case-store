// This is the Prisma schema file for the Store API.
// Models will be added in TASK-006 (Design and create Prisma schema).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Enums

enum UserRole {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum AddressType {
  SHIPPING
  BILLING
}

enum DiscountType {
  PERCENT
  FIXED
}

enum MailOutboxStatus {
  PENDING
  SENT
  FAILED
}

/// Shared publish lifecycle for content models (TASK-187). `status = PUBLISHED`
/// is the SINGLE source of truth for public visibility across Pages (and, later,
/// blog posts and banners). SCHEDULED rows are flipped to PUBLISHED by the
/// PublishingScheduler cron once `scheduledAt` passes.
enum PublishStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

// Models

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  firstName     String?   @map("first_name")
  lastName      String?   @map("last_name")
  phone         String?
  role          UserRole  @default(CUSTOMER)
  isActive      Boolean   @default(true) @map("is_active")
  // Audit tombstone (TASK-104). NULL = live row; non-null = soft-deleted and
  // excluded from every read path. On soft-delete the unique `email` is mangled
  // and the original preserved in `originalEmail`. Distinct from `isActive`,
  // which is a reversible admin visibility toggle.
  originalEmail String?   @map("original_email")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  cart                Cart?
  wishlist            Wishlist?
  orders              Order[]
  addresses           Address[]
  reviews             Review[]
  refreshTokens       RefreshToken[]
  discountRedemptions DiscountRedemption[]

  @@index([deletedAt])
  @@map("users")
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  image       String?
  parentId    String?    @map("parent_id")
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  isActive    Boolean    @default(true) @map("is_active")
  sortOrder   Int        @default(0) @map("sort_order")
  // SEO overrides (TASK-236). Nullable/admin-editable, mirroring Page's pattern;
  // rendering them into storefront <head> metadata is deferred to Phase D.
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  products Product[]

  @@index([slug])
  @@index([parentId])
  @@map("categories")
}

model Product {
  id             String        @id @default(uuid())
  name           String
  slug           String        @unique
  description    String?
  price          Decimal       @db.Decimal(10, 2)
  compareAtPrice Decimal?      @map("compare_at_price") @db.Decimal(10, 2)
  sku            String?       @unique
  // Per-position stock (was ProductVariant.stock). DB CHECK (stock >= 0) is
  // re-applied in the TASK-142 migration; Prisma has no CHECK support.
  stock          Int           @default(0)
  categoryId     String        @map("category_id")
  category       Category      @relation(fields: [categoryId], references: [id])
  // Group membership (TASK-142): sibling positions of the same item (e.g.
  // colours / pack sizes) share a group. Nullable — a standalone position has
  // no group.
  groupId        String?       @map("group_id")
  group          ProductGroup? @relation(fields: [groupId], references: [id])
  // Structured attribute values for this position within its group, keyed by
  // the group's axis names, e.g. {"color": "blue", "pack": "single"}.
  attributes     Json?         @default("{}")
  positionOrder  Int           @default(0) @map("position_order")
  isActive       Boolean       @default(true) @map("is_active")
  // Audit tombstone (TASK-104). NULL = live; non-null = soft-deleted (hidden
  // from all reads). On soft-delete the unique `slug`/`sku` are mangled. The row
  // is kept so historical OrderItems still resolve the product name.
  deletedAt      DateTime?     @map("deleted_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  images        ProductImage[]
  reviews       Review[]
  orderItems    OrderItem[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]

  @@index([slug])
  @@index([categoryId])
  @@index([isActive])
  @@index([deletedAt])
  @@index([groupId])
  @@map("products")
}

// Groups sibling product positions (TASK-142). A group is the abstract item
// (e.g. "Tempered Glass for iPhone 15"); each buyable position (Single Pack,
// Double Pack, a colour, …) is a Product row pointing at this group.
model ProductGroup {
  id        String   @id @default(uuid())
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  positions Product[]
  axes      ProductGroupAxis[]

  @@map("product_groups")
}

// Ordered attribute axis names for a group (e.g. "color", "pack", "storage").
// The PDP renders one selector per axis and resolves the sibling position whose
// attributes match the chosen values.
model ProductGroupAxis {
  id        String       @id @default(uuid())
  groupId   String       @map("group_id")
  group     ProductGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int          @default(0) @map("sort_order")

  @@index([groupId])
  @@map("product_group_axes")
}

model ProductImage {
  id          String   @id @default(uuid())
  productId   String   @map("product_id")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url         String
  alt         String?
  // Tiny base64 WebP LQIP data-URI for the storefront next/image blur placeholder
  // (TASK-091). Nullable: legacy/seed rows and passthrough GIFs have none.
  blurDataUrl String?  @map("blur_data_url")
  sortOrder   Int      @default(0) @map("sort_order")
  isPrimary   Boolean  @default(false) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([productId, sortOrder])
  @@map("product_images")
}

model Cart {
  id        String   @id @default(uuid())
  userId    String?  @unique @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String?  @unique @map("token")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items CartItem[]

  @@index([token])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String   @map("cart_id")
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([cartId, productId])
  @@index([cartId])
  @@map("cart_items")
}

model Order {
  id              String        @id @default(uuid())
  userId          String        @map("user_id")
  user            User          @relation(fields: [userId], references: [id])
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING) @map("payment_status")
  subtotal        Decimal       @db.Decimal(10, 2)
  discount        Decimal       @default(0) @db.Decimal(10, 2)
  // Snapshot of the redeemed promo code (TASK-079), for admin order readability.
  discountCode    String?       @map("discount_code")
  shippingCost    Decimal       @default(0) @map("shipping_cost") @db.Decimal(10, 2)
  tax             Decimal       @default(0) @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(10, 2)
  shippingAddress Json?         @map("shipping_address") // {city, warehouse, address, ref}
  billingAddress  Json?         @map("billing_address") // Same structure
  notes           String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  // Audit tombstone (TASK-104). NULL = live; non-null = soft-deleted and hidden
  // from every read path. Child OrderItems are left in place.
  deletedAt       DateTime?     @map("deleted_at")
  // TASK-228: stamped when an automatic cancellation returned this order's
  // reserved stock to inventory; cleared when the order is revived and the
  // stock is re-reserved. NULL = the order still "owns" its items (reserved in
  // the warehouse or shipped with the parcel). Non-null = the items were
  // credited back to sellable stock, so reviving the order must decrement
  // stock again first (or 409 if it is gone). Tracks only automatic restocks —
  // manual stock adjustments after a physical return are invisible to it.
  restockedAt     DateTime?     @map("restocked_at")

  items OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([deletedAt])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal  @db.Decimal(10, 2) // Price at time of purchase
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@map("order_items")
}

model Address {
  id         String      @id @default(uuid())
  userId     String      @map("user_id")
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       AddressType
  firstName  String      @map("first_name")
  lastName   String      @map("last_name")
  company    String?
  address1   String      @map("address_line_1")
  address2   String?     @map("address_line_2")
  city       String
  state      String?
  postalCode String      @map("postal_code")
  country    String      @default("UA")
  phone      String?
  isDefault  Boolean     @default(false) @map("is_default")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  @@index([userId])
  @@map("addresses")
}

model Review {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int // 1-5
  comment   String?
  isActive  Boolean  @default(false) @map("is_active") // Requires admin approval
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, productId]) // One review per user per product
  @@index([productId])
  @@index([isActive])
  @@map("reviews")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Admin-managed static / service pages (Privacy Policy, FAQ, Returns, …).
/// Rendered on the storefront at /legal/[slug]. Content is Tiptap-generated HTML
/// (sanitized on write). No `deletedAt` tombstone — pages are admin content, not
/// user-generated data, so a hard DELETE is appropriate.
///
/// Publish model (TASK-187): `status` is the SINGLE gate for public visibility
/// (`status = PUBLISHED`). `isActive` is retained ONLY as a derived read-only
/// mirror of `status == PUBLISHED` (kept in sync by the repository on every
/// write) so existing admin list badges/toggles keep working; it is never a
/// gate itself. New content models (blog, banners) adopt `status` only and omit
/// `isActive`.
model Page {
  id              String        @id @default(uuid())
  slug            String        @unique
  title           String
  /// Tiptap-generated HTML; sanitized on write (server-side).
  content         String        @db.Text
  excerpt         String?
  metaTitle       String?       @map("meta_title")
  metaDescription String?       @map("meta_description")
  /// Publish lifecycle — the single source of truth for public visibility.
  status          PublishStatus @default(DRAFT)
  /// Set when the page first transitions to PUBLISHED (or when a scheduled
  /// publish fires). Null while DRAFT / SCHEDULED.
  publishedAt     DateTime?     @map("published_at")
  /// Future publish instant while SCHEDULED; null otherwise.
  scheduledAt     DateTime?     @map("scheduled_at")
  /// Derived read-only mirror of `status == PUBLISHED` (NOT a visibility gate).
  isActive        Boolean       @default(false) @map("is_active")
  sortOrder       Int           @default(0) @map("sort_order")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([slug])
  @@index([status])
  @@map("pages")
}

/// Singleton row storing admin-managed contact information displayed in the
/// storefront footer and contacts page. There is EXACTLY ONE row, always
/// identified by SINGLETON_ID = '00000000-0000-0000-0000-000000000001'.
/// The id is a plain String (not @default(uuid())) — the value is always the
/// well-known constant set by the repository and seed. No isActive / deletedAt:
/// the singleton is always active and is never deleted (TASK-154).
model SiteContactSettings {
  id            String   @id
  email         String?
  phone         String?
  workingHours  String?  @map("working_hours")
  viberLink     String?  @map("viber_link")
  telegramLink  String?  @map("telegram_link")
  instagramLink String?  @map("instagram_link")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("site_contact_settings")
}

/// Promo code / coupon (TASK-079). Codes are stored UPPERCASE and matched
/// case-insensitively. `value` is a percentage (1–100) when `type` is PERCENT,
/// or a fixed UAH amount when FIXED. Eligibility is gated by the active flag,
/// the optional starts/expires window, `minSpend`, and the redemption caps.
model Discount {
  id             String       @id @default(uuid())
  code           String       @unique
  type           DiscountType
  value          Decimal      @db.Decimal(10, 2)
  minSpend       Decimal?     @map("min_spend") @db.Decimal(10, 2)
  maxRedemptions Int?         @map("max_redemptions")
  redeemedCount  Int          @default(0) @map("redeemed_count")
  perUserLimit   Int?         @map("per_user_limit")
  startsAt       DateTime?    @map("starts_at")
  expiresAt      DateTime?    @map("expires_at")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  redemptions DiscountRedemption[]

  @@index([isActive])
  @@map("discounts")
}

/// One redemption of a discount, tied to the order it was applied to. The unique
/// `orderId` makes redeeming idempotent (re-applying to the same order cannot
/// double-count), and per-user counts drive `Discount.perUserLimit`.
model DiscountRedemption {
  id         String   @id @default(uuid())
  discountId String   @map("discount_id")
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId    String   @unique @map("order_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([discountId])
  @@index([userId])
  @@map("discount_redemptions")
}

/// Wishlist / favorites (TASK-076). Mirrors the guest-cart identity model: a
/// wishlist belongs to either a logged-in user (`userId`) or a guest (`token`,
/// carried in the `wishlistToken` cookie), and the guest list merges into the
/// user's on login/register.
model Wishlist {
  id        String   @id @default(uuid())
  userId    String?  @unique @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String?  @unique @map("token")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items WishlistItem[]

  @@index([token])
  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String   @map("wishlist_id")
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String   @map("product_id")
  product    Product  @relation(fields: [productId], references: [id])
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([wishlistId, productId])
  @@index([wishlistId])
  @@map("wishlist_items")
}

/// Transactional mail outbox (TASK-103). Order creation enqueues a row in the
/// same transaction as the order; a cron worker dispatches PENDING rows that are
/// due (`nextAttemptAt <= now`) via the SMTP transport, retrying with backoff up
/// to `maxAttempts` before marking the row FAILED. Generic `type` + JSON
/// `payload` so new mail kinds reuse the table without a migration.
model MailOutbox {
  id            String           @id @default(uuid())
  type          String
  recipient     String
  payload       Json
  status        MailOutboxStatus @default(PENDING)
  attempts      Int              @default(0)
  maxAttempts   Int              @default(5) @map("max_attempts")
  lastError     String?          @map("last_error")
  nextAttemptAt DateTime         @default(now()) @map("next_attempt_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  sentAt        DateTime?        @map("sent_at")

  @@index([status, nextAttemptAt])
  @@map("mail_outbox")
}

/// Blog category — a lightweight taxonomy for BlogPost (TASK-170). Slugs match
/// the storefront filter chip keys (e.g. `reviews`, `guides`). No isActive:
/// categories are always visible; posts gate their own visibility via status.
model BlogCategory {
  id        String     @id @default(uuid())
  slug      String     @unique
  name      String
  sortOrder Int        @default(0) @map("sort_order")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  posts     BlogPost[]

  @@map("blog_categories")
}

/// Blog post (TASK-170). Reuses the shared PublishStatus publishing lifecycle —
/// `status = PUBLISHED` is the SINGLE public-visibility gate; SCHEDULED rows are
/// flipped to PUBLISHED by the PublishingScheduler cron once `scheduledAt`
/// passes. No `isActive` (new content models omit the legacy mirror).
model BlogPost {
  id               String        @id @default(uuid())
  slug             String        @unique
  title            String
  excerpt          String
  /// Tiptap-generated HTML; sanitized on write (server-side).
  content          String        @db.Text
  coverImageUrl    String?       @map("cover_image_url")
  coverBlurDataUrl String?       @map("cover_blur_data_url")
  authorName       String        @map("author_name")
  readingMinutes   Int?          @map("reading_minutes")
  featured         Boolean       @default(false)
  categoryId       String        @map("category_id")
  category         BlogCategory  @relation(fields: [categoryId], references: [id])
  /// Publish lifecycle — the single source of truth for public visibility.
  status           PublishStatus @default(DRAFT)
  /// Set when the post first transitions to PUBLISHED (or when a scheduled
  /// publish fires). Null while DRAFT / SCHEDULED.
  publishedAt      DateTime?     @map("published_at")
  /// Future publish instant while SCHEDULED; null otherwise.
  scheduledAt      DateTime?     @map("scheduled_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@index([status])
  @@index([slug])
  @@index([categoryId])
  @@map("blog_posts")
}

/// Placement slot a banner renders in on the storefront homepage (TASK-186).
/// The admin picks one per banner; the storefront groups published banners by
/// placement and falls back to hardcoded content when a slot has none.
enum BannerPlacement {
  HERO_SLIDE
  PROMO_TILE
  PROMO_BANNER
  ANNOUNCEMENT_BAR
}

/// Admin-managed homepage banner (TASK-186). STRUCTURED content (title /
/// subtitle / CTA), NOT Tiptap HTML — plain strings, no rich-text sanitization.
/// Reuses the shared publishing lifecycle (`status = PUBLISHED` is the single
/// public-visibility gate; SCHEDULED rows are flipped by the PublishingScheduler
/// cron). No `isActive` — new content models omit the legacy mirror.
model Banner {
  id               String          @id @default(uuid())
  /// Homepage slot this banner renders in.
  placement        BannerPlacement
  title            String
  subtitle         String?
  imageUrl         String?         @map("image_url")
  /// Optional base64 blur placeholder for next/image.
  imageBlurDataUrl String?         @map("image_blur_data_url")
  ctaLabel         String?         @map("cta_label")
  ctaHref          String?         @map("cta_href")
  /// Optional accent / variant key (design-token driven; interpreted by the UI).
  theme            String?
  sortOrder        Int             @default(0) @map("sort_order")
  /// Publish lifecycle — the single source of truth for public visibility.
  status           PublishStatus   @default(DRAFT)
  /// Set when the banner first transitions to PUBLISHED (or when a scheduled
  /// publish fires). Null while DRAFT / SCHEDULED.
  publishedAt      DateTime?       @map("published_at")
  /// Future publish instant while SCHEDULED; null otherwise.
  scheduledAt      DateTime?       @map("scheduled_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@index([placement, status])
  @@index([status])
  @@map("banners")
}

/// Status of a customer contact message (TASK-177). NEW = unread submission,
/// READ = an admin has opened it, ARCHIVED = handled/closed. Drives the admin
/// inbox filter and the sidebar unread badge (count of NEW).
enum ContactMessageStatus {
  NEW
  READ
  ARCHIVED
}

/// Customer contact / support message submitted from the storefront contact
/// form (TASK-177). User-generated content — NOT published content, so no
/// PublishStatus / isActive here. `message` is stored as plain text (never
/// sanitized HTML) and escaped by the frontend on render. `orderRef` is an
/// optional free-text order reference the customer types in.
model ContactMessage {
  id        String               @id @default(uuid())
  name      String
  phone     String
  email     String
  topic     String?
  orderRef  String?              @map("order_ref")
  message   String               @db.Text
  status    ContactMessageStatus @default(NEW)
  adminNote String?              @map("admin_note")
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  @@index([status, createdAt(sort: Desc)])
  @@map("contact_messages")
}

/// Newsletter subscription lifecycle (TASK-188). SUBSCRIBED rows are active
/// recipients; UNSUBSCRIBED rows are kept (not deleted) so a re-subscribe
/// re-activates the same row and history/`unsubscribedAt` is preserved.
enum NewsletterStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}

/// Newsletter / marketing-email subscribers (TASK-188). Email is unique and
/// stored normalized (lowercase, trimmed); the public subscribe endpoint is
/// idempotent — subscribing an existing address re-activates an UNSUBSCRIBED row
/// rather than creating a duplicate or erroring. `source` records where the
/// opt-in came from (e.g. `home`, `promo`, `blog`) for basic attribution.
model NewsletterSubscription {
  id             String           @id @default(uuid())
  email          String           @unique
  status         NewsletterStatus @default(SUBSCRIBED)
  source         String?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  unsubscribedAt DateTime?        @map("unsubscribed_at")

  @@index([status])
  @@map("newsletter_subscriptions")
}
