// This is the Prisma schema file for the Store API.
// Models will be added in TASK-006 (Design and create Prisma schema).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Enums

enum UserRole {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum AddressType {
  SHIPPING
  BILLING
}

enum DiscountType {
  PERCENT
  FIXED
}

enum MailOutboxStatus {
  PENDING
  SENT
  FAILED
}

/// Discriminator for an OrderStatusHistory row (TASK-251): whether the row
/// records an order-status change (STATUS — the fromStatus/toStatus pair is
/// populated) or a payment-status change (PAYMENT_STATUS — the
/// fromPaymentStatus/toPaymentStatus pair is populated). The unused pair is
/// left null by convention at the write sites.
enum OrderHistoryChangeType {
  STATUS
  PAYMENT_STATUS
}

/// Data type of a structured product characteristic (TASK-191, plan 112).
/// Drives both the admin editor's input widget (text field / number field /
/// checkbox / select) and the server-side value validation on assignment.
/// Distinct from the variant-axis `Product.attributes Json` — see the
/// AttributeDefinition doc comment.
enum AttributeType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
}

/// Shared publish lifecycle for content models (TASK-187). `status = PUBLISHED`
/// is the SINGLE source of truth for public visibility across Pages (and, later,
/// blog posts and banners). SCHEDULED rows are flipped to PUBLISHED by the
/// PublishingScheduler cron once `scheduledAt` passes.
enum PublishStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

// Models

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  // Nullable since TASK-168: a Google-only account has genuinely no password.
  // login() treats `passwordHash: null` exactly like "no such user" (generic
  // rejection + timing burn) — see AuthService.login.
  passwordHash  String?   @map("password_hash")
  firstName     String?   @map("first_name")
  lastName      String?   @map("last_name")
  phone         String?
  role          UserRole  @default(CUSTOMER)
  isActive      Boolean   @default(true) @map("is_active")
  // Audit tombstone (TASK-104). NULL = live row; non-null = soft-deleted and
  // excluded from every read path. On soft-delete the unique `email` is mangled
  // and the original preserved in `originalEmail`. Distinct from `isActive`,
  // which is a reversible admin visibility toggle.
  originalEmail String?   @map("original_email")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  cart                Cart?
  wishlist            Wishlist?
  orders              Order[]
  addresses           Address[]
  reviews             Review[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  discountRedemptions DiscountRedemption[]
  oauthAccounts       OAuthAccount[]

  @@index([deletedAt])
  @@map("users")
}

model Category {
  id              String     @id @default(uuid())
  name            String
  slug            String     @unique
  description     String?
  image           String?
  parentId        String?    @map("parent_id")
  parent          Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children        Category[] @relation("CategoryHierarchy")
  isActive        Boolean    @default(true) @map("is_active")
  sortOrder       Int        @default(0) @map("sort_order")
  // SEO overrides (TASK-236). Nullable/admin-editable, mirroring Page's pattern.
  // The public category tree read now exposes these via CategoryTreeNodeEntity
  // (TASK-247): the admin's metaTitle/metaDescription win as resolveSeo() tier-1
  // for the category-filtered /products <title>/description, falling back to the
  // category name/description (tier 3) when unset (TASK-240, closing plan 116
  // gap 1).
  metaTitle       String?    @map("meta_title")
  metaDescription String?    @map("meta_description")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  products Product[]

  // Per-category structured-spec templates (TASK-191). Inherited down the
  // subtree at read time via CategoryRepository.findAncestorIds — the relation
  // itself only holds definitions declared DIRECTLY on this category.
  attributeDefinitions AttributeDefinition[]

  // Add-on service template declared DIRECTLY on this category (TASK-174).
  // Inherited down the subtree at read time by AddonApplicabilityResolver
  // (nearest-ancestor-wins) — see CategoryAddonTemplate.
  addonTemplates CategoryAddonTemplate[]

  // Recommendation carousels pointing at this category (TASK-139).
  carousels Carousel[]

  @@index([slug])
  @@index([parentId])
  @@map("categories")
}

/// Product manufacturer / brand (TASK-189, e.g. "Spigen", "Baseus"). Distinct
/// from the compatible-device brand (plan 111's DeviceBrand, e.g. "Apple"): a
/// Spigen case is compatible with an Apple iPhone — two separate concepts, two
/// tables. Linked to Product via a nullable `brandId` (no backfill needed to
/// ship). `isActive` is the reversible admin visibility toggle (hides the brand
/// from the storefront filter/strip); no `deletedAt` tombstone — brands are
/// admin content, not audit-tracked user data.
model Brand {
  id       String  @id @default(uuid())
  name     String
  slug     String  @unique
  logo     String?
  isActive Boolean @default(true) @map("is_active")

  products Product[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([slug])
  @@map("brands")
}

model Product {
  id              String        @id @default(uuid())
  name            String
  slug            String        @unique
  description     String?
  price           Decimal       @db.Decimal(10, 2)
  compareAtPrice  Decimal?      @map("compare_at_price") @db.Decimal(10, 2)
  sku             String?       @unique
  // Per-position stock (was ProductVariant.stock). DB CHECK (stock >= 0) is
  // re-applied in the TASK-142 migration; Prisma has no CHECK support.
  stock           Int           @default(0)
  categoryId      String        @map("category_id")
  category        Category      @relation(fields: [categoryId], references: [id])
  // Group membership (TASK-142): sibling positions of the same item (e.g.
  // colours / pack sizes) share a group. Nullable — a standalone position has
  // no group.
  groupId         String?       @map("group_id")
  group           ProductGroup? @relation(fields: [groupId], references: [id])
  // Manufacturer / brand (TASK-189). Nullable — existing products have no brand
  // until an admin sets one; no backfill required to ship. Distinct from the
  // future compatible-device brand (plan 111).
  brandId         String?       @map("brand_id")
  brand           Brand?        @relation(fields: [brandId], references: [id])
  // Structured attribute values for this position within its group, keyed by
  // the group's axis names, e.g. {"color": "blue", "pack": "single"}.
  attributes      Json?         @default("{}")
  positionOrder   Int           @default(0) @map("position_order")
  isActive        Boolean       @default(true) @map("is_active")
  // SEO overrides (TASK-241). Nullable/admin-editable, mirroring Category/Page.
  // The PDP derives its <title>/description from name/description via resolveSeo()
  // (TASK-240); these columns win as tier 1 (the admin's explicit override).
  metaTitle       String?       @map("meta_title")
  metaDescription String?       @map("meta_description")
  // Audit tombstone (TASK-104). NULL = live; non-null = soft-deleted (hidden
  // from all reads). On soft-delete the unique `slug`/`sku` are mangled. The row
  // is kept so historical OrderItems still resolve the product name.
  deletedAt       DateTime?     @map("deleted_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  images        ProductImage[]
  reviews       Review[]
  orderItems    OrderItem[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  // Device compatibility (TASK-190): which device models this position fits.
  // Compat lives on the Product (position), not the ProductGroup — see
  // ProductDeviceCompat and doc 099 §3.
  deviceCompat  ProductDeviceCompat[]
  // Structured-spec VALUES filled in for this product (TASK-191). Separate
  // system from `attributes Json` above (variant axes) — see plan 112.
  specValues    ProductAttributeValue[]
  // Point deltas against this product's resolved category add-on template
  // (TASK-174): ADD / REMOVE / OVERRIDE. Zero rows = "pure inheritance".
  addonDeltas   AddonServiceDelta[]
  // Hand-picked membership rows on MANUAL recommendation carousels (TASK-139).
  carouselItems CarouselItem[]

  @@index([slug])
  @@index([categoryId])
  @@index([isActive])
  @@index([deletedAt])
  @@index([groupId])
  @@index([brandId])
  @@map("products")
}

// Groups sibling product positions (TASK-142). A group is the abstract item
// (e.g. "Tempered Glass for iPhone 15"); each buyable position (Single Pack,
// Double Pack, a colour, …) is a Product row pointing at this group.
model ProductGroup {
  id        String   @id @default(uuid())
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  positions Product[]
  axes      ProductGroupAxis[]

  @@map("product_groups")
}

// Ordered attribute axis names for a group (e.g. "color", "pack", "storage").
// The PDP renders one selector per axis and resolves the sibling position whose
// attributes match the chosen values.
model ProductGroupAxis {
  id        String       @id @default(uuid())
  groupId   String       @map("group_id")
  group     ProductGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int          @default(0) @map("sort_order")

  @@index([groupId])
  @@map("product_group_axes")
}

model ProductImage {
  id          String   @id @default(uuid())
  productId   String   @map("product_id")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url         String
  alt         String?
  // Tiny base64 WebP LQIP data-URI for the storefront next/image blur placeholder
  // (TASK-091). Nullable: legacy/seed rows and passthrough GIFs have none.
  blurDataUrl String?  @map("blur_data_url")
  sortOrder   Int      @default(0) @map("sort_order")
  isPrimary   Boolean  @default(false) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([productId, sortOrder])
  @@map("product_images")
}

model Cart {
  id        String   @id @default(uuid())
  userId    String?  @unique @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String?  @unique @map("token")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items CartItem[]

  @@index([token])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String   @map("cart_id")
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Add-on services selected for this line (TASK-174). No price snapshot — a
  // cart is a shopping list; prices are resolved live on read.
  addons CartItemAddon[]

  @@unique([cartId, productId])
  @@index([cartId])
  @@map("cart_items")
}

model Order {
  id     String @id @default(uuid())
  userId String @map("user_id")
  // onDelete: Restrict is EXPLICIT, not left to Prisma's default. An order is the
  // record of money taken; it must outlive anything it references. Spelling the
  // rule out here means a future "tidy up the relations" edit that adds Cascade
  // has to consciously delete this line, rather than silently changing behaviour
  // by adding one. Users are soft-deleted (deletedAt) for exactly this reason.
  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING) @map("payment_status")
  subtotal        Decimal       @db.Decimal(10, 2)
  discount        Decimal       @default(0) @db.Decimal(10, 2)
  // Snapshot of the redeemed promo code (TASK-079), for admin order readability.
  discountCode    String?       @map("discount_code")
  shippingCost    Decimal       @default(0) @map("shipping_cost") @db.Decimal(10, 2)
  tax             Decimal       @default(0) @db.Decimal(10, 2)
  // Sum of the frozen OrderItemAddon prices across every line (TASK-174).
  // Like `shippingCost`, it is NEVER part of the discount base — the invariant
  // is `total = subtotal + shippingCost + addonsTotal - discount`, with
  // `discount` computed and clamped against `subtotal` alone (plan 150, owner
  // decision 4).
  addonsTotal     Decimal       @default(0) @map("addons_total") @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(10, 2)
  shippingAddress Json?         @map("shipping_address") // {city, warehouse, address, ref}
  billingAddress  Json?         @map("billing_address") // Same structure
  notes           String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  // Audit tombstone (TASK-104). NULL = live; non-null = soft-deleted and hidden
  // from every read path. Child OrderItems are left in place.
  deletedAt       DateTime?     @map("deleted_at")
  // TASK-228: stamped when an automatic cancellation returned this order's
  // reserved stock to inventory; cleared when the order is revived and the
  // stock is re-reserved. NULL = the order still "owns" its items (reserved in
  // the warehouse or shipped with the parcel). Non-null = the items were
  // credited back to sellable stock, so reviving the order must decrement
  // stock again first (or 409 if it is gone). Tracks only automatic restocks —
  // manual stock adjustments after a physical return are invisible to it.
  restockedAt     DateTime?     @map("restocked_at")

  items         OrderItem[]
  statusHistory OrderStatusHistory[]

  @@index([userId])
  @@index([status])
  // The admin dashboard filters revenue/aggregate queries by paymentStatus on
  // every load. Unindexed, that is a sequential scan of the whole orders table on
  // the busiest admin page — fine at launch, a slow-motion outage once the table
  // grows.
  @@index([paymentStatus])
  @@index([createdAt(sort: Desc)])
  @@index([deletedAt])
  @@map("orders")
}

/// Append-only audit log of every order-status and payment-status change
/// (TASK-251). Written transactionally alongside each mutation in
/// OrderRepository (order creation's initial null→PENDING row, plain status
/// transitions, cancel/revive, and payment-status updates) so the timeline can
/// never drift from the order's real transitions. One table, two change kinds
/// disambiguated by `changeType`: STATUS rows populate from/toStatus (the
/// payment pair stays null) and PAYMENT_STATUS rows populate
/// from/toPaymentStatus (the status pair stays null).
model OrderStatusHistory {
  id                String                 @id @default(uuid())
  orderId           String                 @map("order_id")
  order             Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changeType        OrderHistoryChangeType @map("change_type")
  // Populated only for changeType = STATUS rows; both null for PAYMENT_STATUS rows.
  fromStatus        OrderStatus?           @map("from_status")
  toStatus          OrderStatus?           @map("to_status")
  // Populated only for changeType = PAYMENT_STATUS rows; both null for STATUS rows.
  fromPaymentStatus PaymentStatus?         @map("from_payment_status")
  toPaymentStatus   PaymentStatus?         @map("to_payment_status")
  // Nullable: system/webhook-driven changes (order creation's initial PENDING
  // row today; a future Stripe/payment webhook tomorrow) have no acting
  // admin/customer user. Populated with the acting user's id when the change
  // came from an authenticated request.
  changedBy         String?                @map("changed_by")
  changedAt         DateTime               @default(now()) @map("changed_at")

  @@index([orderId, changedAt])
  @@map("order_status_history")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String @map("product_id")
  // Explicit Restrict for the same reason as Order.user: an order line is a
  // financial record and must survive its product being removed from the catalogue.
  // Products are soft-deleted (deletedAt + isActive:false), never hard-deleted.
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  price     Decimal  @db.Decimal(10, 2) // Price at time of purchase
  createdAt DateTime @default(now()) @map("created_at")

  // Frozen snapshots of the add-on services bought with this line (TASK-174).
  addons OrderItemAddon[]

  @@index([orderId])
  @@map("order_items")
}

model Address {
  id         String      @id @default(uuid())
  userId     String      @map("user_id")
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       AddressType
  firstName  String      @map("first_name")
  lastName   String      @map("last_name")
  company    String?
  address1   String      @map("address_line_1")
  address2   String?     @map("address_line_2")
  city       String
  state      String?
  postalCode String      @map("postal_code")
  country    String      @default("UA")
  phone      String?
  isDefault  Boolean     @default(false) @map("is_default")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  @@index([userId])
  @@map("addresses")
}

model Review {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int // 1-5
  comment   String?
  isActive  Boolean  @default(false) @map("is_active") // Requires admin approval
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, productId]) // One review per user per product
  @@index([productId])
  @@index([isActive])
  @@map("reviews")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  /// SHA-256 hash of the raw token (same at-rest pattern as RefreshToken —
  /// see auth.repository.ts hashToken()). The raw token only ever exists in
  /// the outgoing email link and the client's one-time confirm request.
  token     String    @unique
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  /// Null = unused. Set once, on successful confirm — makes the token single-use.
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Admin-managed static / service pages (Privacy Policy, FAQ, Returns, …).
/// Rendered on the storefront at /legal/[slug]. Content is Tiptap-generated HTML
/// (sanitized on write). No `deletedAt` tombstone — pages are admin content, not
/// user-generated data, so a hard DELETE is appropriate.
///
/// Publish model (TASK-187): `status` is the SINGLE gate for public visibility
/// (`status = PUBLISHED`). `isActive` is retained ONLY as a derived read-only
/// mirror of `status == PUBLISHED` (kept in sync by the repository on every
/// write) so existing admin list badges/toggles keep working; it is never a
/// gate itself. New content models (blog, banners) adopt `status` only and omit
/// `isActive`.
model Page {
  id              String        @id @default(uuid())
  slug            String        @unique
  title           String
  /// Tiptap-generated HTML; sanitized on write (server-side).
  content         String        @db.Text
  excerpt         String?
  metaTitle       String?       @map("meta_title")
  metaDescription String?       @map("meta_description")
  /// Publish lifecycle — the single source of truth for public visibility.
  status          PublishStatus @default(DRAFT)
  /// Set when the page first transitions to PUBLISHED (or when a scheduled
  /// publish fires). Null while DRAFT / SCHEDULED.
  publishedAt     DateTime?     @map("published_at")
  /// Future publish instant while SCHEDULED; null otherwise.
  scheduledAt     DateTime?     @map("scheduled_at")
  /// Derived read-only mirror of `status == PUBLISHED` (NOT a visibility gate).
  isActive        Boolean       @default(false) @map("is_active")
  sortOrder       Int           @default(0) @map("sort_order")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([slug])
  @@index([status])
  @@map("pages")
}

/// Singleton row storing admin-managed contact information displayed in the
/// storefront footer and contacts page. There is EXACTLY ONE row, always
/// identified by SINGLETON_ID = '00000000-0000-0000-0000-000000000001'.
/// The id is a plain String (not @default(uuid())) — the value is always the
/// well-known constant set by the repository and seed. No isActive / deletedAt:
/// the singleton is always active and is never deleted (TASK-154).
model SiteContactSettings {
  id            String   @id
  email         String?
  phone         String?
  workingHours  String?  @map("working_hours")
  viberLink     String?  @map("viber_link")
  telegramLink  String?  @map("telegram_link")
  instagramLink String?  @map("instagram_link")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("site_contact_settings")
}

/// Singleton row for global/default SEO configuration (TASK-239). Feeds the root
/// layout metadata, robots.ts (site-wide noindex), llms.txt (intro override), and
/// the Organization JSON-LD `sameAs` (merged with SiteContactSettings' social
/// links). Distinct SINGLETON_ID from SiteContactSettings
/// ('00000000-0000-0000-0000-000000000002' vs ...0001) — see plan 116 Decision 1.
/// The id is a plain String (not @default(uuid())) — always the well-known
/// constant set by the repository and seed. No isActive / deletedAt: the
/// singleton is always active and is never deleted.
model SeoSettings {
  id                     String   @id
  defaultMetaTitle       String?  @map("default_meta_title")
  defaultMetaDescription String?  @map("default_meta_description")
  /// Must contain exactly one `%s` token when set, e.g. "%s | MobileStore".
  /// Null → falls back to the current hardcoded `%s | ${SITE_NAME}` template.
  titleTemplate          String?  @map("title_template")
  defaultOgImage         String?  @map("default_og_image")
  /// URL of the uploaded store logo (TASK-299). Rendered in the storefront
  /// header/footer and the admin sidebar; null → both fall back to the
  /// typographic monogram. Also emitted as Organization JSON-LD `logo`.
  logoUrl                String?  @map("logo_url")
  /// Google Search Console ownership-verification token (HTML-tag method): the
  /// `content` attribute value of `<meta name="google-site-verification" content="…">`.
  /// Null → no `verification.google` key is emitted in the root layout's metadata
  /// (Next omits the tag entirely rather than rendering an empty one). See plan 146.
  googleSiteVerification String?  @map("google_site_verification")
  /// Bing Webmaster Tools ownership-verification token (HTML-tag method): the
  /// `content` attribute value of `<meta name="msvalidate.01" content="…">`.
  /// Null → no `verification.other['msvalidate.01']` key is emitted. See plan 146.
  bingSiteVerification   String?  @map("bing_site_verification")
  /// Site-wide noindex kill switch (staging vs prod). Default false (assume
  /// production once this ships).
  noindexSite            Boolean  @default(false) @map("noindex_site")
  /// Overrides only the intro paragraph of /llms.txt — see plan 116 Decision 5.
  llmsTxtSummary         String?  @map("llms_txt_summary") @db.Text
  /// One-per-line brand-authority profile URLs (Facebook/YouTube/LinkedIn/X/
  /// Google Business/Wikipedia, ...) — merged into Organization `sameAs`
  /// alongside SiteContactSettings' viber/telegram/instagram. See Decision 4.
  additionalSameAsLinks  String[] @default([]) @map("additional_sameas_links")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("seo_settings")
}

/// Global, admin-editable FAQ entries (TASK-242, plan 116 Decision 3). One
/// reusable list (NOT per-product) reused on /info and the PDP, and emitted as
/// FAQPage JSON-LD for AI/search visibility. No publish lifecycle (simpler than
/// Page/Banner) — just isActive (reversible visibility) + sortOrder, mirroring
/// the Brand module's simple-CRUD shape. Seeded from the storefront's static
/// INFO_FAQS (6 Q&A) so the admin sees real content on first load.
model FaqItem {
  id        String   @id @default(uuid())
  question  String
  answer    String   @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("faq_items")
}

/// Promo code / coupon (TASK-079). Codes are stored UPPERCASE and matched
/// case-insensitively. `value` is a percentage (1–100) when `type` is PERCENT,
/// or a fixed UAH amount when FIXED. Eligibility is gated by the active flag,
/// the optional starts/expires window, `minSpend`, and the redemption caps.
model Discount {
  id             String       @id @default(uuid())
  code           String       @unique
  type           DiscountType
  value          Decimal      @db.Decimal(10, 2)
  minSpend       Decimal?     @map("min_spend") @db.Decimal(10, 2)
  maxRedemptions Int?         @map("max_redemptions")
  redeemedCount  Int          @default(0) @map("redeemed_count")
  perUserLimit   Int?         @map("per_user_limit")
  startsAt       DateTime?    @map("starts_at")
  expiresAt      DateTime?    @map("expires_at")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  redemptions DiscountRedemption[]

  @@index([isActive])
  @@map("discounts")
}

/// One redemption of a discount, tied to the order it was applied to. The unique
/// `orderId` makes redeeming idempotent (re-applying to the same order cannot
/// double-count), and per-user counts drive `Discount.perUserLimit`.
model DiscountRedemption {
  id         String   @id @default(uuid())
  discountId String   @map("discount_id")
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId    String   @unique @map("order_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([discountId])
  @@index([userId])
  @@map("discount_redemptions")
}

/// Wishlist / favorites (TASK-076). Mirrors the guest-cart identity model: a
/// wishlist belongs to either a logged-in user (`userId`) or a guest (`token`,
/// carried in the `wishlistToken` cookie), and the guest list merges into the
/// user's on login/register.
model Wishlist {
  id        String   @id @default(uuid())
  userId    String?  @unique @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String?  @unique @map("token")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items WishlistItem[]

  @@index([token])
  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String   @map("wishlist_id")
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String   @map("product_id")
  product    Product  @relation(fields: [productId], references: [id])
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([wishlistId, productId])
  @@index([wishlistId])
  @@map("wishlist_items")
}

/// Transactional mail outbox (TASK-103). Order creation enqueues a row in the
/// same transaction as the order; a cron worker dispatches PENDING rows that are
/// due (`nextAttemptAt <= now`) via the SMTP transport, retrying with backoff up
/// to `maxAttempts` before marking the row FAILED. Generic `type` + JSON
/// `payload` so new mail kinds reuse the table without a migration.
model MailOutbox {
  id            String           @id @default(uuid())
  type          String
  recipient     String
  payload       Json
  status        MailOutboxStatus @default(PENDING)
  attempts      Int              @default(0)
  maxAttempts   Int              @default(5) @map("max_attempts")
  lastError     String?          @map("last_error")
  nextAttemptAt DateTime         @default(now()) @map("next_attempt_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  sentAt        DateTime?        @map("sent_at")

  @@index([status, nextAttemptAt])
  @@map("mail_outbox")
}

/// Blog category — a lightweight taxonomy for BlogPost (TASK-170). Slugs match
/// the storefront filter chip keys (e.g. `reviews`, `guides`). No isActive:
/// categories are always visible; posts gate their own visibility via status.
model BlogCategory {
  id        String     @id @default(uuid())
  slug      String     @unique
  name      String
  sortOrder Int        @default(0) @map("sort_order")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  posts     BlogPost[]

  @@map("blog_categories")
}

/// Blog post (TASK-170). Reuses the shared PublishStatus publishing lifecycle —
/// `status = PUBLISHED` is the SINGLE public-visibility gate; SCHEDULED rows are
/// flipped to PUBLISHED by the PublishingScheduler cron once `scheduledAt`
/// passes. No `isActive` (new content models omit the legacy mirror).
model BlogPost {
  id               String        @id @default(uuid())
  slug             String        @unique
  title            String
  excerpt          String
  /// Tiptap-generated HTML; sanitized on write (server-side).
  content          String        @db.Text
  coverImageUrl    String?       @map("cover_image_url")
  coverBlurDataUrl String?       @map("cover_blur_data_url")
  authorName       String        @map("author_name")
  readingMinutes   Int?          @map("reading_minutes")
  featured         Boolean       @default(false)
  categoryId       String        @map("category_id")
  category         BlogCategory  @relation(fields: [categoryId], references: [id])
  /// Publish lifecycle — the single source of truth for public visibility.
  status           PublishStatus @default(DRAFT)
  /// Set when the post first transitions to PUBLISHED (or when a scheduled
  /// publish fires). Null while DRAFT / SCHEDULED.
  publishedAt      DateTime?     @map("published_at")
  /// Future publish instant while SCHEDULED; null otherwise.
  scheduledAt      DateTime?     @map("scheduled_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@index([status])
  @@index([slug])
  @@index([categoryId])
  @@map("blog_posts")
}

/// Placement slot a banner renders in on the storefront homepage (TASK-186).
/// The admin picks one per banner; the storefront groups published banners by
/// placement and falls back to hardcoded content when a slot has none.
enum BannerPlacement {
  HERO_SLIDE
  PROMO_TILE
  PROMO_BANNER
  ANNOUNCEMENT_BAR
}

/// Admin-managed homepage banner (TASK-186). STRUCTURED content (title /
/// subtitle / CTA), NOT Tiptap HTML — plain strings, no rich-text sanitization.
/// Reuses the shared publishing lifecycle (`status = PUBLISHED` is the single
/// public-visibility gate; SCHEDULED rows are flipped by the PublishingScheduler
/// cron). No `isActive` — new content models omit the legacy mirror.
model Banner {
  id               String          @id @default(uuid())
  /// Homepage slot this banner renders in.
  placement        BannerPlacement
  title            String
  subtitle         String?
  imageUrl         String?         @map("image_url")
  /// Optional base64 blur placeholder for next/image.
  imageBlurDataUrl String?         @map("image_blur_data_url")
  ctaLabel         String?         @map("cta_label")
  ctaHref          String?         @map("cta_href")
  /// Optional accent / variant key (design-token driven; interpreted by the UI).
  theme            String?
  sortOrder        Int             @default(0) @map("sort_order")
  /// Publish lifecycle — the single source of truth for public visibility.
  status           PublishStatus   @default(DRAFT)
  /// Set when the banner first transitions to PUBLISHED (or when a scheduled
  /// publish fires). Null while DRAFT / SCHEDULED.
  publishedAt      DateTime?       @map("published_at")
  /// Future publish instant while SCHEDULED; null otherwise.
  scheduledAt      DateTime?       @map("scheduled_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@index([placement, status])
  @@index([status])
  @@map("banners")
}

/// Status of a customer contact message (TASK-177). NEW = unread submission,
/// IN_PROGRESS = an admin is actively handling it (TASK-256), READ = an admin
/// has opened it, ARCHIVED = handled/closed. Drives the admin inbox filter and
/// the sidebar unread badge (count of NEW).
enum ContactMessageStatus {
  NEW
  IN_PROGRESS
  READ
  ARCHIVED
}

/// Customer contact / support message submitted from the storefront contact
/// form (TASK-177). User-generated content — NOT published content, so no
/// PublishStatus / isActive here. `message` is stored as plain text (never
/// sanitized HTML) and escaped by the frontend on render. `orderRef` is an
/// optional free-text order reference the customer types in.
model ContactMessage {
  id        String               @id @default(uuid())
  name      String
  phone     String
  email     String
  topic     String?
  orderRef  String?              @map("order_ref")
  message   String               @db.Text
  status    ContactMessageStatus @default(NEW)
  adminNote String?              @map("admin_note")
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  @@index([status, createdAt(sort: Desc)])
  @@map("contact_messages")
}

/// Newsletter subscription lifecycle (TASK-188). SUBSCRIBED rows are active
/// recipients; UNSUBSCRIBED rows are kept (not deleted) so a re-subscribe
/// re-activates the same row and history/`unsubscribedAt` is preserved.
enum NewsletterStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}

/// Newsletter / marketing-email subscribers (TASK-188). Email is unique and
/// stored normalized (lowercase, trimmed); the public subscribe endpoint is
/// idempotent — subscribing an existing address re-activates an UNSUBSCRIBED row
/// rather than creating a duplicate or erroring. `source` records where the
/// opt-in came from (e.g. `home`, `promo`, `blog`) for basic attribution.
model NewsletterSubscription {
  id             String           @id @default(uuid())
  email          String           @unique
  status         NewsletterStatus @default(SUBSCRIBED)
  source         String?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  unsubscribedAt DateTime?        @map("unsubscribed_at")

  @@index([status])
  @@map("newsletter_subscriptions")
}

/// Manufacturer of a compatible device (TASK-190) — e.g. Apple, Samsung, Xiaomi.
/// Distinct from `Brand` (plan 110, the product's own manufacturer): a case made
/// by brand "Spigen" can be compatible with an Apple device. `isActive` is a
/// reversible admin visibility toggle (hides the brand + its models from public
/// pickers/filters); it is never a tombstone.
model DeviceBrand {
  id        String  @id @default(uuid())
  name      String
  slug      String  @unique
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  models DeviceModel[]

  @@map("device_brands")
}

/// A specific compatible device (TASK-190) — e.g. "iPhone 15 Pro", "Galaxy S24".
/// Belongs to a `DeviceBrand`; `series` groups models for the storefront picker
/// cascade (e.g. "iPhone 15"), `releaseYear` is informational. Compatibility is
/// expressed via the `ProductDeviceCompat` join to `Product` positions.
model DeviceModel {
  id            String      @id @default(uuid())
  deviceBrandId String      @map("device_brand_id")
  brand         DeviceBrand @relation(fields: [deviceBrandId], references: [id])
  name          String
  slug          String      @unique
  series        String?
  releaseYear   Int?        @map("release_year")
  isActive      Boolean     @default(true) @map("is_active")

  compat ProductDeviceCompat[]

  @@index([deviceBrandId])
  @@map("device_models")
}

/// Join table for the Product ↔ DeviceModel many-to-many device-compatibility
/// axis (TASK-190). A row means "this product position fits this device model".
/// `onDelete: Cascade` on both sides is correct — the join row's lifecycle is
/// fully owned by its two parents (not a cross-aggregate reference). The
/// composite primary key makes re-assigning the same pair idempotent (no dupes).
model ProductDeviceCompat {
  productId     String      @map("product_id")
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  deviceModelId String      @map("device_model_id")
  deviceModel   DeviceModel @relation(fields: [deviceModelId], references: [id], onDelete: Cascade)

  @@id([productId, deviceModelId])
  @@index([deviceModelId])
  @@map("product_device_compat")
}

/// Per-category template for a structured product characteristic (TASK-191,
/// plan 112 / doc 099 §4.3). Defines WHAT facts a category's products carry
/// ("Матеріал", type SELECT, options ["Силікон","Шкіра"]); the filled-in value
/// per product lives in ProductAttributeValue. Templates are inherited down the
/// subtree at read time (a definition on "Чохли" applies to "Чохли для
/// смартфонів" beneath it) via CategoryRepository.findAncestorIds; a leaf
/// category may override an ancestor's same-`key` definition (deepest wins).
///
/// This is a SEPARATE system from `Product.attributes Json` (the variant-axis
/// map that drives PDP sibling navigation) — the two may hold the same
/// conceptual value for different reasons, and that overlap is expected.
model AttributeDefinition {
  id           String        @id @default(uuid())
  categoryId   String        @map("category_id")
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// Stable, URL/filter-safe token (kebab or camel, no spaces), e.g. `material`.
  key          String
  /// Human-readable label shown in admin + on the PDP, e.g. "Матеріал".
  label        String
  type         AttributeType @default(TEXT)
  /// Optional unit suffix appended on render, e.g. "W", "mm".
  unit         String?
  /// Allowed values when `type = SELECT` (JSON string array). Null otherwise.
  options      Json?
  /// When true, this spec is surfaced as a catalog facet + PDP highlight.
  isFilterable Boolean       @default(false) @map("is_filterable")
  sortOrder    Int           @default(0) @map("sort_order")

  values ProductAttributeValue[]

  @@unique([categoryId, key])
  @@index([categoryId, sortOrder])
  @@map("attribute_definitions")
}

/// A filled-in structured-spec value for one product (TASK-191, plan 112). Ties
/// a product to an AttributeDefinition template and stores the value. `value` is
/// always the canonical string form (also used for exact facet matching);
/// `valueNumber` mirrors it as a Decimal for NUMBER-typed definitions so future
/// range filters can query numerically without parsing text.
model ProductAttributeValue {
  id           String              @id @default(uuid())
  productId    String              @map("product_id")
  product      Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  definitionId String              @map("definition_id")
  definition   AttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  value        String
  valueNumber  Decimal?            @map("value_number") @db.Decimal(12, 3)

  @@unique([productId, definitionId])
  @@index([definitionId, value])
  @@map("product_attribute_values")
}

/// Discriminates which content model a SlugRedirect row belongs to (TASK-285).
enum SlugRedirectEntity {
  PAGE
  BLOG_POST
  PRODUCT
  CATEGORY
}

/// Server-side 301-redirect ledger for admin-renamed content slugs (TASK-285, SEO-10). One row
/// per DEAD alias: `oldSlug` no longer resolves directly for that entity type, and a visitor
/// landing on it should be sent to `newSlug` with a PERMANENT (301) redirect.
///
/// INVARIANT, maintained entirely at write time by `slug-redirect-chain.util.ts` (never at read
/// time): for a given `entity`, no row's `newSlug` ever equals another row's `oldSlug` — every
/// dead alias points DIRECTLY at the entity's CURRENT live slug, never through an intermediate
/// dead one, and a row can never have `oldSlug === newSlug` (a self-redirect). This is what makes
/// the public lookup a single O(1) unique-key read with no chain-walking and — critically — no
/// possibility of a redirect loop, however many times the same entity gets renamed back and
/// forth. See plan 147 §Design Decision 2 for the exact write-time algorithm and its proof.
model SlugRedirect {
  id        String             @id @default(uuid())
  entity    SlugRedirectEntity
  oldSlug   String             @map("old_slug")
  newSlug   String             @map("new_slug")
  /// Updated whenever a later rename repoints this row (chain collapse) — see plan 147
  /// Design Decision 1.
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  @@unique([entity, oldSlug])
  @@index([entity, newSlug])
  @@map("slug_redirects")
}

/// Admin-managed catalog of purchasable add-on services (warranty / insurance /
/// setup, TASK-174). Replaces the store-client stub catalog
/// (`widgets/cart/model/addon-services.ts`). `isActive` is the standard
/// reversible visibility toggle — an inactive service disappears from the
/// resolver's output immediately (both template membership AND any product
/// delta involving it), but is NOT retroactively stripped from carts/orders
/// that already reference it (a cart re-validates live on the next read; orders
/// are frozen snapshots, unaffected either way).
model AddonService {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  categoryTemplates CategoryAddonTemplate[]
  productDeltas     AddonServiceDelta[]
  cartItemAddons    CartItemAddon[]
  orderItemAddons   OrderItemAddon[]

  @@index([isActive])
  @@map("addon_services")
}

/// One add-on service belonging to a category's OWN template (plan 150, owner
/// decision 1). A category with zero rows here has no template of its own and
/// inherits its nearest ancestor's template (nearest-ancestor-wins — see
/// AddonApplicabilityResolver); a category with >= 1 row here fully replaces
/// whatever its ancestors would have contributed (prototype own-property
/// shadowing, not a merge). The relationship is intentionally a live join, not
/// a value copy — editing these rows changes the resolved set everywhere the
/// template applies, immediately.
model CategoryAddonTemplate {
  id             String       @id @default(uuid())
  categoryId     String       @map("category_id")
  category       Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  addonServiceId String       @map("addon_service_id")
  addonService   AddonService @relation(fields: [addonServiceId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([categoryId, addonServiceId])
  @@index([categoryId])
  @@index([addonServiceId])
  @@map("category_addon_templates")
}

/// A product-level point delta against its resolved category template (plan
/// 150, owner decision 2). At most one delta row per (product, add-on service)
/// pair — `type` disambiguates ADD (exclusive to this product, independent of
/// any template membership) / REMOVE (suppress an inherited add-on for this
/// product) / OVERRIDE (this product's own price for an inherited add-on).
/// `price` is only meaningful for ADD (optional — null means "use the catalog
/// AddonService.price") and OVERRIDE (required); it is ignored for REMOVE.
/// Validated at the service layer, not by a DB CHECK (Prisma has no CHECK
/// support — same documented limitation as `Product.stock >= 0`).
model AddonServiceDelta {
  id             String         @id @default(uuid())
  productId      String         @map("product_id")
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  addonServiceId String         @map("addon_service_id")
  addonService   AddonService   @relation(fields: [addonServiceId], references: [id], onDelete: Cascade)
  type           AddonDeltaType
  price          Decimal?       @db.Decimal(10, 2)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@unique([productId, addonServiceId])
  @@index([productId])
  @@map("addon_service_deltas")
}

enum AddonDeltaType {
  ADD
  REMOVE
  OVERRIDE
}

/// A customer's selection of a resolved add-on for one cart line (TASK-174).
/// Mirrors `CartItem` itself: no price snapshot here — the live resolved price
/// is read at cart-render/order-creation time (a cart is a "shopping list", not
/// a receipt; snapshotting only happens at order creation, exactly like
/// `Product.price` vs `OrderItem.price`).
model CartItemAddon {
  id             String       @id @default(uuid())
  cartItemId     String       @map("cart_item_id")
  cartItem       CartItem     @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  addonServiceId String       @map("addon_service_id")
  addonService   AddonService @relation(fields: [addonServiceId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([cartItemId, addonServiceId])
  @@index([cartItemId])
  @@map("cart_item_addons")
}

/// Snapshot of a selected add-on at order-creation time (TASK-174). `name` and
/// `price` are copied at the moment `OrderRepository.createFromCart` runs —
/// exactly like `OrderItem.price` snapshots `Product.price` — so a later
/// catalog-price change, template edit, or delta edit never rewrites history.
/// `addonServiceId` is nullable + `onDelete: SetNull` for symmetry with how
/// `OrderItem.product` is never hard-deleted (Product uses `deletedAt`
/// tombstones) — `AddonService` has no hard-delete path either (an admin can
/// only deactivate), so this column is not expected to go null in practice, but
/// the schema does not assume that invariant holds forever.
model OrderItemAddon {
  id             String        @id @default(uuid())
  orderItemId    String        @map("order_item_id")
  orderItem      OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  addonServiceId String?       @map("addon_service_id")
  addonService   AddonService? @relation(fields: [addonServiceId], references: [id], onDelete: SetNull)
  name           String
  price          Decimal       @db.Decimal(10, 2)
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([orderItemId])
  @@map("order_item_addons")
}

/// External OAuth identity providers this store accepts (TASK-168). Google
/// only — Apple stays a client-only stub (owner decision 2026-07-11).
enum OAuthProvider {
  GOOGLE
}

/// Links a `User` to an external OAuth identity (TASK-168). One row per
/// (provider, providerId) pair, created either at first-time signup (brand-new
/// email) or at first-time linking (an existing password-based account signs
/// in with Google using the same verified email — see
/// AuthService.loginWithGoogleProfile). `providerId` is the provider's stable
/// subject id (Google's `profile.id` — the OIDC `sub` claim), NEVER the email:
/// a Google account's email can change, its `sub` cannot. `email` is a
/// link-time snapshot for admin/diagnostic reads only — `User.email` remains
/// the single source of truth for the account's contact address.
model OAuthAccount {
  id         String        @id @default(uuid())
  provider   OAuthProvider
  providerId String        @map("provider_id")
  userId     String        @map("user_id")
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  email      String
  createdAt  DateTime      @default(now()) @map("created_at")

  @@unique([provider, providerId])
  @@index([userId])
  @@map("oauth_accounts")
}

/// How a Carousel's product list is computed (TASK-139). Mirrors the "rules +
/// manual pick" owner decision: four rule-based sources reuse the existing
/// product-query capabilities (ProductService.findAll), MANUAL is backed by
/// its own CarouselItem rows.
enum CarouselSource {
  BESTSELLING
  NEWEST
  ON_SALE
  CATEGORY
  MANUAL
}

/// Where a Carousel surfaces on the homepage (TASK-288). HOME_TABS — the carousel
/// feeds ONE tab of the "Популярне" section at the top of the page (its `title` is
/// the tab label; tabs are ordered by `sortOrder`). HOME_RAILS — the carousel is
/// rendered as its own standalone horizontal rail further down (today's behaviour).
enum CarouselPlacement {
  HOME_TABS
  HOME_RAILS
}

/// Admin-managed homepage recommendation carousel (TASK-139). Structural copy
/// of `Banner` (publish lifecycle + sortOrder) with one added dimension: `source`
/// determines how the product list is computed at read time — this model never
/// stores a resolved product list except via `CarouselItem` (MANUAL only).
/// `categoryId` is meaningful only when `source = CATEGORY`; `itemLimit` is
/// meaningful only for the four rule-based sources (ignored for MANUAL, whose
/// count is simply the number of `CarouselItem` rows). Both constraints are
/// enforced at the DTO/service layer, not by a DB CHECK (same documented
/// limitation as `Product.stock >= 0` elsewhere in this schema).
model Carousel {
  id          String            @id @default(uuid())
  title       String
  /// How the product list is computed — see {@link CarouselSource}.
  source      CarouselSource
  /// Category to pull from — REQUIRED when source = CATEGORY, ignored
  /// otherwise. SetNull (not Cascade) on category deletion: a carousel must
  /// survive its category disappearing — it just resolves to zero products
  /// until an admin repoints it.
  categoryId  String?           @map("category_id")
  category    Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// Max products to show for a rule-based source (1–24, default 12 — matches
  /// PopularRail/RecentlyViewed's existing rail size). Ignored for MANUAL.
  itemLimit   Int               @default(12) @map("item_limit")
  /// Where this carousel surfaces on the homepage — see {@link CarouselPlacement}.
  /// Defaults to HOME_RAILS so every carousel that predates TASK-288 keeps its
  /// current standalone-rail behaviour untouched.
  placement   CarouselPlacement @default(HOME_RAILS) @map("placement")
  /// Display order (lower = first) WITHIN the carousel's `placement` — the tab
  /// order inside the "Популярне" section for HOME_TABS, the top-to-bottom rail
  /// order for HOME_RAILS. Same semantics as `Banner.sortOrder` within a placement.
  sortOrder   Int               @default(0) @map("sort_order")
  /// Publish lifecycle — the single source of truth for public visibility.
  status      PublishStatus     @default(DRAFT)
  publishedAt DateTime?         @map("published_at")
  scheduledAt DateTime?         @map("scheduled_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  items CarouselItem[]

  @@index([status, sortOrder])
  /// Serves the TASK-288 placement-scoped public read
  /// (`status = PUBLISHED AND placement = ? ORDER BY sort_order`); the
  /// status-leading index above still covers the unscoped list.
  @@index([placement, status, sortOrder])
  @@index([categoryId])
  @@map("carousels")
}

/// One hand-picked product on a MANUAL carousel (TASK-139), with its own
/// display order. Inert (never read by the resolver) on non-MANUAL carousels —
/// switching a carousel's source away from and back to MANUAL does not lose
/// its item rows, by design (no cleanup-on-switch).
/// `onDelete: Cascade` on `product` mirrors `WishlistItem`'s live-membership
/// join (not a snapshot — if a product row were ever hard-deleted, which this
/// codebase does not do for Product, the membership row should go with it).
model CarouselItem {
  id         String   @id @default(uuid())
  carouselId String   @map("carousel_id")
  carousel   Carousel @relation(fields: [carouselId], references: [id], onDelete: Cascade)
  productId  String   @map("product_id")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([carouselId, productId])
  @@index([carouselId, sortOrder])
  @@map("carousel_items")
}
