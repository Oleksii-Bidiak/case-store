# store-api — environment variables
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.

# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/store?schema=public"

# ─── Auth (JWT) ───────────────────────────────────────────────────────────────
# Secrets MUST be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-32+-character-random-secret"
JWT_REFRESH_SECRET="change-me-to-a-different-32+-char-secret"
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# ─── Umami analytics CSP (TASK-261) — optional ────────────────────────────────
# The public origin serving self-hosted Umami, e.g. https://analytics.mystore.ua
# — matches the *origin* portion of the storefront's NEXT_PUBLIC_UMAMI_SRC. When
# set AND NODE_ENV=production, it is added to the Helmet scriptSrc/connectSrc CSP
# directives. CAVEAT: this header is only sent on responses store-api itself
# serves (Swagger UI, /health) — it does NOT gate the storefront pages, which
# send no CSP header of their own. Kept for defense-in-depth on API-served
# surfaces and to future-proof a possible storefront CSP. Leave empty in dev.
UMAMI_ORIGIN=

# ─── Mail (transactional email) ───────────────────────────────────────────────
# All optional. When MAIL_ENABLED is not "true", no email is sent and the SMTP_*
# vars below are ignored (the app boots and all tests pass without them).
#
# For local development without a real SMTP server, generate free throwaway
# credentials at https://ethereal.email/ and paste them below.
MAIL_ENABLED=false
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
# "true" for implicit TLS (port 465); otherwise STARTTLS is used (port 587).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender shown to recipients, e.g. "MobileStore <no-reply@mobilestore.example>"
MAIL_FROM="MobileStore <no-reply@mobilestore.example>"

# ─── Admin seed (optional) ───
# Consumed only by `prisma db seed` to provision the initial ADMIN account.
# Falls back to admin@store.com / Admin123! when unset. To promote an existing
# user instead, run: UPDATE users SET role='ADMIN' WHERE email='<email>';
ADMIN_SEED_EMAIL=admin@store.com
ADMIN_SEED_PASSWORD=Admin123!

# Nova Poshta delivery integration (TASK-080)
# API-ключ з кабінету Нової Пошти:
#   new.novaposhta.ua → Налаштування → Безпека → Ключі API
# Без ключа застосунок стартує нормально: ендпоінти доставки віддають 503,
# а чекаут відкочується на ручний (free-text) ввід міста/адреси.
NP_API_KEY=

# Необов'язковий bootstrap-фолбек для міста-відправника (NP city UUID).
# Джерело правди — сторінка "Налаштування доставки" в адмінці (DeliverySetting);
# ця змінна використовується лише поки оператор не задав точку відправлення там.
# Якщо порожньо — дефолт Київ (db5c88e0-391c-11dd-90d9-001a92567626).
NP_SENDER_CITY_REF=

# ─── Meilisearch full-text search (TASK-075) ──────────────────────────────────
# All optional. Leave MEILI_HOST / MEILI_MASTER_KEY empty to disable search —
# the API boots normally and /api/search transparently falls back to the
# Postgres `contains` scan (no typo tolerance, but fully functional).
#
# Local dev: bring the container up (`docker compose up -d meilisearch`) and set:
#   MEILI_HOST=http://localhost:7700
#   MEILI_MASTER_KEY=<the same master key used by the meilisearch service>
# The master key must be at least 16 chars (Meili's own requirement). Use a
# throwaway value locally; never commit a real key.
#
# MEILI_HOST: engine base URL.
# MEILI_MASTER_KEY: admin/master key — server-side index writes + queries.
# MEILI_SEARCH_KEY: optional public search-only key (reserved for future
#   browser-side querying; unused by the backend today).
MEILI_HOST=
MEILI_MASTER_KEY=
MEILI_SEARCH_KEY=

# ─── Sentry error tracking (TASK-048) ─────────────────────────────────────────
# All optional. Leave SENTRY_DSN empty to disable Sentry entirely — the SDK runs
# with `enabled: false` and is a complete no-op (no network calls, no events), so
# the app boots and all tests pass without a Sentry account.
#
# SENTRY_DSN: project ingest URL from Sentry (Project Settings → Client Keys).
# SENTRY_ENVIRONMENT: environment tag (production, staging, ...). Defaults to NODE_ENV.
# SENTRY_TRACES_SAMPLE_RATE: performance-trace sample rate 0..1 (default 0 = off).
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=