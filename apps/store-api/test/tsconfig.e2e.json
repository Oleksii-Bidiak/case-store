{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "isolatedModules": true,
    "rootDir": ".",
    "paths": {
      "@/*": ["../src/*"]
    },
    "types": ["jest", "node"]
  },
  "include": ["../src/**/*", "./**/*"]
}
