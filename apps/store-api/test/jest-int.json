{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".int-spec.ts$",
  "setupFiles": ["<rootDir>/setup-int.ts"],
  "transformIgnorePatterns": [
    "/node_modules/(?!(?:sanitize-html|htmlparser2|domhandler|domutils|domelementtype|dom-serializer|entities)/)"
  ],
  "transform": {
    "/node_modules/(?:sanitize-html|htmlparser2|domhandler|domutils|domelementtype|dom-serializer|entities)/.*\\.js$": [
      "ts-jest",
      {
        "isolatedModules": true,
        "tsconfig": {
          "allowJs": true,
          "module": "commonjs",
          "moduleResolution": "node",
          "target": "ES2021",
          "esModuleInterop": true,
          "skipLibCheck": true
        }
      }
    ],
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/tsconfig.e2e.json"
      }
    ]
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/../src/$1"
  },
  "testTimeout": 30000
}
