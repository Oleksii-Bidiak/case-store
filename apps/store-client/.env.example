# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Umami self-hosted analytics (TASK-261) — both optional ───────────────────
# Set BOTH together to activate storefront tracking; leave either empty (the
# local-dev default) and the analytics facade stays a complete no-op — the
# tracker <Script> never renders, so the storefront works with zero new console
# errors. Naming contract shared with the prod compose Umami service (TASK-270).
#
# NEXT_PUBLIC_UMAMI_SRC: full URL of Umami's tracker script
#   (e.g. https://analytics.mystore.ua/script.js).
# NEXT_PUBLIC_UMAMI_WEBSITE_ID: the website id (UUID) from the Umami dashboard.
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# ─── Sentry error tracking (TASK-048) — all optional ──────────────────────────
# Leave NEXT_PUBLIC_SENTRY_DSN empty to disable Sentry entirely: the SDK runs
# with `enabled: false` and is a complete no-op, so dev/CI builds are unaffected.
#
# NEXT_PUBLIC_SENTRY_DSN: browser + server DSN from Sentry (public — safe to expose).
# NEXT_PUBLIC_SENTRY_ENVIRONMENT: environment tag (defaults to NODE_ENV).
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE: perf-trace sample rate 0..1 (default 0).
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
#
# Source-map upload (build time only — NOT required to build or run). Set these
# in CI to upload readable stack traces; unset, upload is skipped with a warning.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=