# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Google sign-in button (TASK-402) — optional, OFF by default ──────────────
# Set to exactly `true` ONLY on a deployment whose API really carries
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET. Unset or anything else hides the
# "Google" button on /login: without those API secrets the button leads to a
# 500, and an advertised sign-in method that cannot sign anyone in is worse
# than no button at all. Baked at build time, like every NEXT_PUBLIC_* value —
# changing it needs a rebuild, not just a restart.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=

# ─── Umami self-hosted analytics (TASK-261) — both optional ───────────────────
# Set BOTH together to activate storefront tracking; leave either empty (the
# local-dev default) and the analytics facade stays a complete no-op — the
# tracker <Script> never renders, so the storefront works with zero new console
# errors. Naming contract shared with the prod compose Umami service (TASK-270).
#
# NEXT_PUBLIC_UMAMI_SRC: full URL of Umami's tracker script
#   (e.g. https://analytics.mystore.ua/script.js).
# NEXT_PUBLIC_UMAMI_WEBSITE_ID: the website id (UUID) from the Umami dashboard.
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# ─── IndexNow instant-index ping (TASK-282) — optional ────────────────────────
# Ownership key for the IndexNow protocol (https://www.indexnow.org/). When set,
# /api/revalidate pings api.indexnow.org with the changed URLs after each admin
# publish, and /indexnow.txt serves this key to prove domain ownership.
# Bing and Seznam honor IndexNow; Google ignores it (harmless). Production-only:
# outside NODE_ENV=production the ping is a complete no-op, and it is also a
# no-op while this stays empty — so local dev/CI never call out.
# Server-only secret: NO NEXT_PUBLIC_ prefix — must never reach the client bundle.
# Generate a key with e.g.: openssl rand -hex 16
INDEXNOW_KEY=

# ─── Sentry error tracking (TASK-048) — all optional ──────────────────────────
# Leave NEXT_PUBLIC_SENTRY_DSN empty to disable Sentry entirely: the SDK runs
# with `enabled: false` and is a complete no-op, so dev/CI builds are unaffected.
#
# NEXT_PUBLIC_SENTRY_DSN: browser + server DSN from Sentry (public — safe to expose).
# NEXT_PUBLIC_SENTRY_ENVIRONMENT: environment tag (defaults to NODE_ENV).
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE: perf-trace sample rate 0..1 (default 0).
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
#
# Source-map upload (build time only — NOT required to build or run). Set these
# in CI to upload readable stack traces; unset, upload is skipped with a warning.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=