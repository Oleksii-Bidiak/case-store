# OpenCode (optional — for AI-assisted development)
OPENCODE_GO_API_KEY=

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=store_dev
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/store_dev

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# JWT Authentication (MUST be set before running in production)
JWT_SECRET=
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# pgAdmin (optional — only needed with `docker compose --profile tools up`)
PGADMIN_EMAIL=admin@store.local
PGADMIN_PASSWORD=

# Application
NODE_ENV=development
PORT=3001