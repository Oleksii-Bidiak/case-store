{
  "name": "store-test-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile Accessories E-Commerce Store — Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w apps/store-api -w apps/store-client -w apps/store-admin",
    "lint": "npm run lint -w apps/store-api -w apps/store-client -w apps/store-admin",
    "test": "npm run test -w apps/store-api -w apps/store-client -w apps/store-admin",
    "test:e2e": "npm run test:e2e -w apps/store-api",
    "test:e2e:pw": "playwright test",
    "typecheck": "npm run typecheck -w apps/store-api -w apps/store-client -w apps/store-admin",
    "db:generate": "npm run prisma:generate -w apps/store-api",
    "db:push": "npm run prisma:push -w apps/store-api",
    "db:migrate": "npm run prisma:migrate -w apps/store-api",
    "db:seed": "npm run prisma:seed -w apps/store-api",
    "db:studio": "npm run prisma:studio -w apps/store-api",
    "generate:api": "npm run generate:api -w apps/store-client -w apps/store-admin",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/jest": "^30.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
