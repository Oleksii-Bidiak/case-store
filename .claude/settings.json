{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git worktree:*)",
      "Bash(git stash:*)",
      "Bash(npm run build:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run start:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run generate:api:*)",
      "Bash(npm run swagger:export:*)",
      "Bash(npx prisma:*)",
      "Bash(docker compose:*)",
      "Bash(ls:*)",
      "Bash(node:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git branch:*)",
      "PowerShell(git add:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git merge:*)",
      "PowerShell(git switch:*)",
      "PowerShell(git checkout:*)",
      "PowerShell(git worktree:*)",
      "PowerShell(git stash:*)",
      "PowerShell(npm run build:*)",
      "PowerShell(npm run test:*)",
      "PowerShell(npm run lint:*)",
      "PowerShell(npm run typecheck:*)",
      "PowerShell(npm run start:*)",
      "PowerShell(npm run dev:*)",
      "PowerShell(npm run generate:api:*)",
      "PowerShell(npm run swagger:export:*)",
      "PowerShell(npx prisma:*)",
      "PowerShell(docker compose:*)",
      "PowerShell(node:*)",
      "mcp__context7__query-docs"
    ],
    "deny": [
      "Read(.env)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/.env.*.local)",
      "Edit(**/shared/api/generated/**)",
      "Write(**/shared/api/generated/**)"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-edits.js"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-bash.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/guard-destructive.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/format-on-save.js"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "andrej-karpathy-skills@karpathy-skills": true,
    "superpowers@claude-plugins-official": true
  },
  "worktree": {
    "baseRef": "head"
  }
}
