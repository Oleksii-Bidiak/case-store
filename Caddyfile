# Caddyfile — PRODUCTION reverse proxy for the case-store stack (TASK-270).
#
# Caddy provisions and renews Let's Encrypt (or ZeroSSL) certificates
# automatically for all three sites, provided the domains' A/AAAA records point
# at this host and ports 80/443 are publicly reachable. No manual certbot/nginx.
#
# {$DOMAIN} / {$PORT} are substituted from the container environment (sourced
# from .env.production via docker-compose.prod.yml). Locally, set DOMAIN=localhost
# and Caddy serves HTTPS via its own internal CA (self-signed, browser-untrusted
# but functional) instead of hitting a public ACME endpoint.
#
# To receive certificate-expiry notices, add a global options block with your
# email:  {  email you@example.com  }
#
# STAGING USES A DIFFERENT FILE: Caddyfile.staging, mounted over this one by
# docker-compose.staging.yml (TASK-307). It is a separate file rather than an
# env-var toggle in this one because Caddy adapts the config BEFORE any request
# matcher runs, so a `basic_auth` block with an empty password fails to parse at
# start-up — it cannot be conditionally disabled from the environment. Keep the
# three site blocks below in sync with that file.

# ─── Storefront (root domain) ───────────────────────────────────────────────
{$DOMAIN} {
	# Optimized images are immutable by construction: the URL carries the source
	# path, the width and the quality, so any change produces a DIFFERENT URL.
	# Without this header the browser re-asks for every thumbnail on every page
	# view, and each miss that reaches Next costs 100-400 ms of pinned CPU on a
	# 2-vCPU box — a cold catalogue page is 40-60 such transforms. This is the
	# single cheapest thing standing between the current box and the next one up
	# (TASK-387).
	@nextImage path /_next/image*
	header @nextImage Cache-Control "public, max-age=31536000, immutable"

	encode zstd gzip
	reverse_proxy store-client:3000
}

# ─── Admin panel (admin. subdomain) ─────────────────────────────────────────
# An admin login page has no business in a search index, even on the real store.
admin.{$DOMAIN} {
	header X-Robots-Tag "noindex, nofollow, noarchive"

	encode zstd gzip
	reverse_proxy store-admin:3002
}

# ─── API + uploaded images (api. subdomain) ─────────────────────────────────
# store-api serves /api/*, the unprefixed /health probe, and static product
# images at /uploads/* — all proxied through here on the app's configured PORT.
api.{$DOMAIN} {
	header X-Robots-Tag "noindex, nofollow"

	# Uploaded files are content-addressed — every upload gets a fresh UUID
	# filename (`local-disk-storage.service.ts`), so a URL's bytes never change
	# and a replacement is simply a different URL. NestJS's ServeStatic answers
	# with `max-age=0` + ETag, which makes every browser and the Next.js image
	# optimizer re-validate on each request; those round trips are served by the
	# same Node event loop that handles the JSON API. Overriding here keeps
	# product photos off that loop entirely (TASK-387).
	@uploads path /uploads/*
	header @uploads Cache-Control "public, max-age=31536000, immutable"

	encode zstd gzip
	reverse_proxy store-api:{$PORT}
}

# ─── Umami analytics (analytics. subdomain) ─────────────────────────────────
# WHY THIS BLOCK IS NOT OPTIONAL (TASK-378): the tracker is loaded by the
# VISITOR'S BROWSER from NEXT_PUBLIC_UMAMI_SRC. With Umami reachable only on the
# host's loopback port, that URL cannot exist, no script ever loads, and the
# analytics stack collects exactly nothing — while every container reports
# healthy. It looked like "the admin panel shows no statistics"; the truth was
# that no statistics were ever recorded.
#
# Two hostnames must therefore agree: the A record for analytics.<domain> and
# NEXT_PUBLIC_UMAMI_SRC (= https://analytics.<domain>/script.js), which is baked
# into the storefront at BUILD time — see docs/deploy/05a-analytics.md.
#
# BEFORE pointing DNS here, change Umami's default admin/umami login. This block
# publishes its dashboard as well as its tracker.
analytics.{$DOMAIN} {
	header X-Robots-Tag "noindex, nofollow, noarchive"

	encode zstd gzip
	reverse_proxy umami:3000
}
